---
---

<header class="header">
  <div class="header-container">
    <a href="#" class="brand">
      <img src="/logo_oficial.jpeg" alt="Nova Smart - Distribuidor Autorizado Claro" class="brand-logo" />
    </a>

    <nav class="nav-menu" id="navMenu">
      <a href="#inicio" class="nav-link active">Inicio</a>
      <a href="#nosotros" class="nav-link">Quiénes Somos</a>
      <a href="#planes" class="nav-link">Planes Fibra</a>
      <a href="#servicios" class="nav-link">Servicios</a>
      <a href="#galeria" class="nav-link">Nuestro Equipo</a>
      <a href="#trabajos" class="nav-link">Bolsa de Trabajo</a>
      <a href="#contacto" class="nav-link">Contacto</a>
    </nav>

    <div class="header-actions">
      <a href="#planes" class="btn btn-primary btn-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
        <span>Solicitar Fibra Óptica</span>
      </a>
      <button class="mobile-toggle" id="mobileToggle" aria-label="Abrir Menú">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 84px;
    width: 100%;
    max-width: 100%;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 62px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-logo:hover {
    transform: scale(1.04);
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.925rem;
    color: var(--color-dark-heading);
    transition: all 0.25s ease;
    position: relative;
    padding: 0.4rem 0.25rem;
    letter-spacing: -0.01em;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2.5px;
    background: var(--gradient-primary);
    border-radius: 4px;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateX(-50%);
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-sm {
    padding: 0.65rem 1.4rem;
    font-size: 0.875rem;
    background: var(--gradient-primary);
    box-shadow: 0 4px 14px rgba(227, 6, 19, 0.3);
  }

  .btn-sm:hover {
    box-shadow: 0 6px 20px rgba(227, 6, 19, 0.45);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .mobile-toggle span {
    width: 100%;
    height: 2px;
    background-color: var(--color-dark);
    border-radius: 2px;
  }

  @media (max-width: 1024px) {
    .header-container {
      height: 80px;
    }

    .mobile-toggle {
      display: flex;
    }

    .brand-logo {
      height: 54px;
    }

    .nav-menu {
      position: absolute;
      top: 80px;
      left: 0;
      width: 100%;
      background: #FFFFFF;
      flex-direction: column;
      padding: 1.75rem 2rem;
      gap: 1.25rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      clip-path: circle(0% at 100% 0);
      transition: clip-path 0.4s ease-in-out;
    }

    .nav-menu.open {
      clip-path: circle(140% at 100% 0);
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileToggle');
  const navMenu = document.getElementById('navMenu');

  toggleBtn?.addEventListener('click', () => {
    navMenu?.classList.toggle('open');
  });

  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      navMenu?.classList.remove('open');
    });
  });
</script>
