---
import Layout from '../../layouts/Layout.astro';

const lastUpdated = '6 de noviembre de 2026';

const secciones = [
  {
    id: 'intro',
    num: '01',
    titulo: 'Introducción',
    cuerpo: [
      'Esta Política de Privacidad describe cómo <strong>PC Telecom S.A.C.</strong> (marca comercial <strong>Nova Smart</strong>) recopila, usa, almacena y protege la información a través de <strong>Nova App</strong> (<code>com.novasmart.app</code>), nuestra aplicación móvil interna de gestión operativa.',
      'Nova App <strong>no es una aplicación de uso público</strong>: está destinada exclusivamente al personal de Nova Smart —colaboradores, técnicos, conductores y personal administrativo— para registrar asistencia, gestionar la flota vehicular, el almacén, las ventas e instalaciones, y otras funciones operativas internas. El acceso requiere una cuenta creada y autorizada por la empresa.',
    ],
  },
  {
    id: 'info',
    num: '02',
    titulo: 'Información que recopilamos',
    lede: 'Según el rol y los módulos a los que el colaborador tenga acceso, Nova App puede recopilar:',
    lista: [
      ['Datos de identificación', 'nombres, apellidos, DNI/CE, teléfono, dirección, fecha de nacimiento, cargo y área de la empresa.'],
      ['Licencia de conducir', 'para personal con un vehículo de la empresa asignado — número, fechas de emisión y vencimiento, estado.'],
      ['Ubicación (GPS)', 'al marcar asistencia, para verificar que ocurre dentro de la geocerca autorizada, y durante visitas de campo registradas en la app.'],
      ['Fotos y biometría facial', 'una foto de verificación facial al marcar asistencia, para confirmar identidad y prevenir suplantación. También fotos operativas: control diario de vehículos (agua, aceite, kilometraje), evidencia de movimientos de almacén, actas e incidencias.'],
      ['Datos del dispositivo', 'en equipos corporativos bajo administración MDM: modelo, versión del sistema, e indicador de ubicación simulada ("mock location") para prevenir fraude de marcación.'],
      ['Registros operativos', 'horarios, kilometraje, gastos de caja chica, movimientos de inventario, ventas e instalaciones, comunicados internos.'],
    ],
    nota: 'No solicitamos datos bancarios ni contraseñas de otros servicios a través de la app.',
  },
  {
    id: 'uso',
    num: '03',
    titulo: 'Uso de la información',
    lede: 'Utilizamos la información recopilada exclusivamente para fines operativos internos:',
    lista: [
      ['Gestión de personal', 'asistencia, horarios y administración del personal.'],
      ['Prevención de fraude', 'verificar la identidad de quien marca asistencia, incluida la detección de ubicación simulada en dispositivos corporativos.'],
      ['Gestión de activos', 'administrar la flota vehicular (mantenimiento, kilometraje, documentos) y el almacén de la empresa.'],
      ['Cumplimiento legal', 'obligaciones laborales, contables y tributarias aplicables en el Perú.'],
    ],
    nota: 'No usamos esta información con fines publicitarios ni para nada ajeno a la relación laboral o contractual del colaborador con la empresa.',
  },
  {
    id: 'datos',
    num: '04',
    titulo: 'Compartición de datos',
    cuerpo: [
      'No vendemos datos personales. La información se almacena en la infraestructura en la nube que utilizamos para operar la app, y solo accede a ella el personal autorizado de Nova Smart según su rol y permisos. Podemos revelar información cuando una autoridad competente o una obligación legal lo requiera.',
    ],
  },
  {
    id: 'seguridad',
    num: '05',
    titulo: 'Almacenamiento y seguridad',
    cuerpo: [
      'Los datos se almacenan con controles de acceso basados en roles, de modo que cada colaborador ve solo la información que le corresponde según su función. Las comunicaciones entre la app y nuestros servidores están cifradas en tránsito. Aplicamos medidas razonables para evitar accesos no autorizados; ningún sistema puede garantizar seguridad absoluta.',
    ],
  },
  {
    id: 'retencion',
    num: '06',
    titulo: 'Retención de datos',
    cuerpo: [
      'Conservamos la información mientras dure la relación laboral o contractual del colaborador con la empresa, y por el tiempo adicional que exijan las normas laborales, tributarias o contables aplicables en el Perú. Al finalizar dicha relación, el acceso del colaborador a la app se desactiva.',
    ],
  },
  {
    id: 'derechos',
    num: '07',
    titulo: 'Derechos del usuario',
    cuerpo: [
      'Como colaborador de Nova Smart, puedes solicitar acceso, corrección o eliminación de tus datos personales registrados en Nova App, de acuerdo con la Ley N.° 29733 de Protección de Datos Personales del Perú, contactando directamente al área de Sistemas o de Recursos Humanos de la empresa.',
    ],
  },
  {
    id: 'cambios',
    num: '08',
    titulo: 'Cambios a esta política',
    cuerpo: [
      'Podemos actualizar esta Política de Privacidad periódicamente, por ejemplo al agregar nuevas funciones a la app. Cualquier cambio será publicado en esta misma página con la fecha de actualización correspondiente.',
    ],
  },
];
---

<Layout
  title="Privacidad de Nova App | NovaSmart"
  description="Política de privacidad de Nova App, la aplicación interna de gestión operativa de Nova Smart (PC Telecom S.A.C.) para su personal."
  noindex={true}
>
  <div class="legal-doc">
    <!-- Cabecera tipo ficha, no hero de marketing -->
    <header class="legal-doc__head">
      <div class="container legal-doc__head-inner">
        <h1 class="legal-doc__title">Política de Privacidad</h1>
      </div>
    </header>

    <div class="container legal-doc__body">
      <!-- Índice: regla fina + número, sin tarjetas -->
      <nav class="legal-doc__index" aria-label="Contenido">
        <ol>
          {secciones.map((s) => (
            <li><a href={`#${s.id}`} data-idx={s.num}>{s.titulo}</a></li>
          ))}
          <li><a href="#contacto" data-idx="09">Contacto</a></li>
        </ol>
      </nav>

      <!-- Contenido -->
      <div class="legal-doc__sections">
        {secciones.map((s) => (
          <section id={s.id} class="legal-doc__section">
            <span class="legal-doc__num" aria-hidden="true">{s.num}</span>
            <h2>{s.titulo}</h2>
            {s.cuerpo && s.cuerpo.map((p) => <p set:html={p} />)}
            {s.lede && <p>{s.lede}</p>}
            {s.lista && (
              <dl class="legal-doc__deflist">
                {s.lista.map(([t, d]) => (
                  <>
                    <dt>{t}</dt>
                    <dd>{d}</dd>
                  </>
                ))}
              </dl>
            )}
            {s.nota && <p class="legal-doc__nota">{s.nota}</p>}
          </section>
        ))}

        <section id="contacto" class="legal-doc__section legal-doc__contact">
          <span class="legal-doc__num legal-doc__num--light" aria-hidden="true">09</span>
          <h2>Contacto</h2>
          <p>Si tienes preguntas sobre esta política o quieres ejercer tus derechos sobre tus datos:</p>
          <address>
            <strong>PC Telecom S.A.C.</strong><br />
            Av. Alfredo Benavides Nro. 1180, Int. 1102, Urb. Prolongación Benavides, Lima — Perú<br />
            <a href="tel:+51983985748">+51 983 985 748</a>
          </address>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-doc {
    --rule: var(--line);
    --accent: var(--coral);
    background: var(--cream);
  }

  /* ===== Cabecera ===== */
  .legal-doc__head {
    border-bottom: 1px solid var(--rule);
    padding: 3.5rem 0 2.75rem;
  }

  .legal-doc__head-inner {
    max-width: 720px;
  }

  .legal-doc__title {
    font: 800 clamp(2.1rem, 4.4vw, 3rem) / 1.05 var(--serif);
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
  }

  /* ===== Cuerpo: índice + secciones ===== */
  .legal-doc__body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4.5rem;
    padding: 3.25rem 0 5rem;
    align-items: start;
  }

  .legal-doc__index {
    /* Fija debajo del header del sitio (82px, sticky top:0) — sin este
       offset el índice quedaba tapado por el header al hacer scroll. */
    position: sticky;
    top: calc(82px + 1.75rem);
  }

  .legal-doc__index-label {
    display: block;
    font: 700 0.68rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .legal-doc__index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }

  .legal-doc__index a {
    display: flex;
    gap: 0.6rem;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.86rem;
    line-height: 1.35;
    color: #555;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .legal-doc__index a[data-active] {
    border-left-color: var(--accent);
    color: var(--ink);
    font-weight: 700;
  }

  .legal-doc__index a:hover {
    color: var(--ink);
  }

  .legal-doc__index a::before {
    content: attr(data-idx);
    font: 600 0.72rem/1.3 var(--sans);
    color: #b7b7b7;
  }

  .legal-doc__index a[data-active]::before {
    color: var(--accent);
  }

  /* ===== Secciones ===== */
  .legal-doc__sections {
    max-width: 680px;
  }

  .legal-doc__section {
    position: relative;
    padding: 2.4rem 0 2.4rem 0;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1.5rem;
  }

  .legal-doc__sections .legal-doc__section:first-child {
    border-top: none;
    padding-top: 0;
  }

  .legal-doc__num {
    display: block;
    font: 800 0.78rem/1 var(--sans);
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .legal-doc__section h2 {
    font: 800 1.45rem/1.2 var(--serif);
    letter-spacing: normal;
    color: var(--ink);
    margin: 0 0 0.9rem;
  }

  .legal-doc__section p {
    font-size: 0.98rem;
    line-height: 1.75;
    color: #333;
    margin: 0 0 0.9rem;
  }

  .legal-doc__section p:last-child {
    margin-bottom: 0;
  }

  .legal-doc__section code {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.88em;
    background: #ece9e3;
    padding: 0.1em 0.4em;
    border-radius: 4px;
  }

  .legal-doc__nota {
    font-size: 0.88rem !important;
    color: var(--muted) !important;
    padding-left: 0.9rem;
    border-left: 2px solid var(--rule);
  }

  .legal-doc__deflist {
    margin: 0 0 1rem;
    display: grid;
    gap: 1rem;
  }

  .legal-doc__deflist dt {
    font: 700 0.95rem/1.3 var(--sans);
    color: var(--ink);
  }

  .legal-doc__deflist dd {
    margin: 0.2rem 0 0;
    font-size: 0.96rem;
    line-height: 1.65;
    color: #3c3c3c;
  }

  /* Contacto: bloque invertido, no tarjeta rosa */
  .legal-doc__contact {
    margin-top: 1rem;
    padding: 2.25rem 2rem;
    background: var(--ink);
    border-radius: 14px;
    border-top: none;
  }

  .legal-doc__contact .legal-doc__num--light {
    color: #ff9a92;
  }

  .legal-doc__contact h2,
  .legal-doc__contact p {
    color: #fff;
  }

  .legal-doc__contact p {
    color: #c7c7cf;
  }

  .legal-doc__contact address {
    font-style: normal;
    margin-top: 1rem;
    font-size: 0.96rem;
    line-height: 1.8;
    color: #e4e4e8;
  }

  .legal-doc__contact address a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 860px) {
    .legal-doc__body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .legal-doc__index {
      position: static;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 1.5rem;
    }

    .legal-doc__index ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0;
      border-left: none;
    }

    .legal-doc__index a {
      border-left: none;
      padding: 0.3rem 0.8rem 0.3rem 0;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.legal-doc__index a'));
  const targets = links
    .map((a) => document.querySelector(a.getAttribute('href') || ''))
    .filter((el): el is Element => !!el);

  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector(link.getAttribute('href') || '');
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Resalta en el índice la sección cuyo encabezado ya pasó la línea de referencia
  // (más robusto que IntersectionObserver con secciones de alto variable).
  if (targets.length) {
    const REF_LINE = 140; // px desde arriba del viewport
    let ticking = false;

    function actualizarActivo() {
      ticking = false;
      let actual = targets[0];
      for (const t of targets) {
        if (t.getBoundingClientRect().top - REF_LINE <= 0) actual = t;
        else break;
      }
      links.forEach((l) => l.removeAttribute('data-active'));
      const link = links.find((l) => l.getAttribute('href') === `#${actual.id}`);
      link?.setAttribute('data-active', 'true');
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(actualizarActivo);
          ticking = true;
        }
      },
      { passive: true }
    );
    actualizarActivo();
  }
</script>
