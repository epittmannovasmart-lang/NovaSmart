---
import Layout from '../layouts/Layout.astro';
import StoreMap from '../components/StoreMap.astro';
---

<Layout title="Visitar Nuestras Tiendas" description="Encuentra la sede autorizada Claro de Nova Smart más cercana." minimalHeader={true}>
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb--1"></div>
      <div class="hero-orb hero-orb--2"></div>
      <div class="hero-grid"></div>
    </div>
    <div class="container hero-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Inicio
        </a>
        <span class="breadcrumb-sep">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </span>
        <span class="breadcrumb-current">Visitar Nuestras Tiendas</span>
      </nav>
      <div class="hero-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
        Encuentra tu tienda más cercana
      </div>
      <h1 class="hero-title">Visitar Nuestras<br/><span class="hero-title--accent">Tiendas</span></h1>
      <p class="hero-subtitle">Encuentra la sede autorizada Claro de Nova Smart más cercana y recibe atención personalizada.</p>
    </div>
  </section>

  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">5+</span>
          <span class="stat-label">Sedes Autorizadas</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">10</span>
          <span class="stat-unit">hrs</span>
          <span class="stat-label">Atención Diaria</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">100</span>
          <span class="stat-unit">%</span>
          <span class="stat-label">Satisfacción</span>
        </div>
      </div>
    </div>
  </section>

  <section class="services section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Encontrarás</span>
        <h2 class="section-title">Todo en<br/><span class="text-accent">un solo lugar</span></h2>
        <p class="section-desc">Nuestras tiendas ofrecen todos los servicios que necesitas para estar conectado.</p>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"/></svg>
          </div>
          <h3>Contratación Directa</h3>
          <p>Contrata tu servicio de fibra óptica de manera inmediata con asesoría personalizada.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm16,160H112V128h32Zm0-48H112V80h32Z"/></svg>
          </div>
          <h3>Pago de Facturas</h3>
          <p>Aceptamos múltiples métodos de pago: efectivo, tarjeta, transferencia y Yape.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
          </div>
          <h3>Soporte Presencial</h3>
          <p>Resolución de incidencias técnicas directamente en tienda con especialistas.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176Zm-16-84a12,12,0,1,1,12-12A12,12,0,0,1,128,92Z"/></svg>
          </div>
          <h3>Atención Personalizada</h3>
          <p>Orientación experta para elegir el plan y servicio que mejor se adapte a tus necesidades.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="map-section section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Ubicación de Tiendas</span>
        <h2 class="section-title">Nuestras Tiendas<br/><span class="text-accent">Oficiales</span></h2>
        <p class="section-desc">Encuentra y ubica nuestras sedes autorizadas Claro de Nova Smart en el mapa.</p>
      </div>
      <div class="map-wrapper">
        <StoreMap />
      </div>
    </div>
  </section>


</Layout>

<style is:global>
  .hero {
    position: relative;
    padding: 8rem 0 5rem;
    background: var(--color-dark);
    overflow: hidden;
    text-align: center;
  }

  .hero-bg { position: absolute; inset: 0; overflow: hidden; }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .hero-orb--1 { width: 500px; height: 500px; background: var(--color-primary); top: -200px; right: -100px; }
  .hero-orb--2 { width: 400px; height: 400px; background: #B90000; bottom: -150px; left: -100px; }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-container { position: relative; z-index: 1; }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .breadcrumb a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: #FFFFFF;
  }

  .breadcrumb-sep {
    color: #475569;
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: #FFFFFF;
    font-weight: 600;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(227, 6, 19, 0.15);
    border: 1px solid rgba(227, 6, 19, 0.3);
    color: #FF6B6B;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-title--accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #94A3B8;
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-glow);
    transition: all 0.3s ease;
  }

  .btn-hero:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(227, 6, 19, 0.5); }

  .btn-hero-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-hero-outline:hover { background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); }

  .stats { padding: 3.5rem 0; background: var(--color-bg-white); border-bottom: 1px solid var(--color-border); }

  .stats-grid { display: flex; align-items: center; justify-content: center; gap: 3rem; flex-wrap: wrap; }

  .stat-item { text-align: center; }

  .stat-number { font-family: var(--font-heading); font-size: 2.5rem; font-weight: 900; color: var(--color-primary); line-height: 1; }
  .stat-unit { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-primary); }
  .stat-label { display: block; font-size: 0.85rem; color: var(--color-text-muted); margin-top: 0.3rem; }
  .stat-divider { width: 1px; height: 50px; background: var(--color-border); }

  .section-header { text-align: center; max-width: 600px; margin: 0 auto 3.5rem; }

  .section-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .section-title { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; line-height: 1.15; margin-bottom: 1rem; }

  .text-accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-desc { font-size: 1.05rem; color: var(--color-text-muted); line-height: 1.7; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .service-card {
    padding: 2rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all 0.35s ease;
  }

  .service-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-card-hover); border-color: var(--color-primary-border); }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--color-primary-light);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .service-card h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .service-card p { font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.6; }

  .hours-card {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding: 3rem;
    background: var(--color-dark);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .hours-content { flex: 1; }
  .hours-content h2 { font-size: 2rem; font-weight: 800; color: #FFFFFF; margin-bottom: 2rem; }

  .hours-grid { display: flex; flex-direction: column; gap: 1rem; }

  .hours-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: rgba(255,255,255,0.06);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .hours-day { font-weight: 600; color: #FFFFFF; font-size: 0.95rem; }
  .hours-time { font-weight: 700; color: #10B981; font-size: 0.95rem; }

  .hours-item--closed .hours-time { color: #F59E0B; }

  .hours-visual { flex-shrink: 0; }

  .hours-clock {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 140px;
    background: rgba(227, 6, 19, 0.1);
    border-radius: 50%;
    color: var(--color-primary);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.8; }
  }

  .map-section { background: var(--color-bg-light); }
  .map-wrapper { border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-card-hover); margin-bottom: 1.25rem; }

  .stores-scroll {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: #CBD5E1 transparent;
  }

  .stores-scroll::-webkit-scrollbar { height: 6px; }
  .stores-scroll::-webkit-scrollbar-track { background: transparent; }
  .stores-scroll::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }

  .store-chip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 180px;
    transition: all 0.3s ease;
  }

  .store-chip:hover { border-color: var(--color-primary-border); }

  .store-chip-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .store-chip strong { display: block; font-size: 0.82rem; font-weight: 700; color: var(--color-text); }
  .store-chip span { font-size: 0.72rem; color: var(--color-text-muted); }

  .cta-section {
    position: relative;
    padding: 5rem 0;
    background: var(--color-dark);
    overflow: hidden;
    text-align: center;
  }

  .cta-bg { position: absolute; inset: 0; overflow: hidden; }

  .cta-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3; }
  .cta-orb--1 { width: 400px; height: 400px; background: var(--color-primary); top: -150px; left: 20%; }
  .cta-orb--2 { width: 300px; height: 300px; background: #B90000; bottom: -100px; right: 20%; }

  .cta-container { position: relative; z-index: 1; }

  .cta-content h2 { font-size: clamp(2rem, 4vw, 2.5rem); font-weight: 800; color: #FFFFFF; margin-bottom: 1rem; }
  .cta-content p { font-size: 1.1rem; color: #94A3B8; margin-bottom: 2rem; }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2.5rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-glow);
    transition: all 0.3s ease;
  }

  .btn-cta:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(227, 6, 19, 0.5); }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr; }
    .hours-card { flex-direction: column; gap: 2rem; text-align: center; }
    .hours-item { flex-direction: column; gap: 0.5rem; text-align: center; }
    .stats-grid { gap: 1.5rem; }
    .stat-divider { display: none; }
  }

  @media (max-width: 576px) {
    .hero { padding: 6rem 0 3rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  }
</style>
