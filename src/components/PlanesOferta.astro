---
---

<section id="planes" class="section-padding planes-section">
  <div class="container">
    <div class="section-header text-center reveal">
      <span class="badge badge-red">Modalidades de Servicio</span>
      <h2 class="section-title">Planes y Combos Claro Fibra Óptica</h2>
      <p class="section-description">
        Conoce nuestras modalidades de servicio residencial y corporativo. Selecciona el plan de tu interés y consulta la disponibilidad en tu zona.
      </p>
    </div>

    <!-- Modalities Showcase Box -->
    <div class="planes-showcase-box reveal reveal-delay-1">
      <div class="planes-header">
        <div class="speed-switcher">
          <button class="plan-tab active" data-title="1 Play — Internet Fibra Óptica" data-desc="Conexión de Internet por Fibra Óptica 100% Simétrica para alta velocidad en navegación, descargas masivas, videoconferencias y teletrabajo.">1 Play (Internet)</button>
          <button class="plan-tab" data-title="2 Play — Internet + TV o Telefónica" data-desc="Combo dúo ideal: Internet por Fibra Óptica acompañado del servicio de Claro TV+ o Telefonía Fija residencial con beneficios integrados.">2 Play (Int + TV / Telf)</button>
          <button class="plan-tab" data-title="3 Play — Trío Completo" data-desc="Solución integral para tu hogar: Internet por Fibra Óptica + Claro TV+ + Telefonía Fija con máxima velocidad y entretenimiento completo.">3 Play (Trío Completo)</button>
        </div>
      </div>

      <div class="planes-content">
        <div class="plan-details">
          <div class="speed-title-box">
            <h3 class="plan-title-text" id="planTitleVal">1 Play — Internet Fibra Óptica</h3>
          </div>
          <p id="planDescText" class="plan-desc-text">Conexión de Internet por Fibra Óptica 100% Simétrica para alta velocidad en navegación, descargas masivas, videoconferencias y teletrabajo.</p>

          <div class="plan-ctas">
            <a href="#contacto" class="btn btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              <span>Consultar Plan de su Interés</span>
            </a>
          </div>
        </div>

        <div class="plan-benefits-card">
          <h4>Beneficios Destacados:</h4>
          <ul class="benefits-list">
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Velocidad 100% Simétrica (misma velocidad de subida y bajada)</span>
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Router Wi-Fi Dual Band de Alta Fidelidad Incluido</span>
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Instalación técnica profesional en tiempo récord</span>
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Soporte técnico continuo y atención personalizada</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .planes-section {
    background-color: var(--color-bg-light);
  }

  .section-header {
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: 2.3rem;
    font-weight: 800;
    margin: 0.75rem 0 1rem;
  }

  .section-description {
    font-size: 1.05rem;
    color: var(--color-text-body);
  }

  /* Showcase Box */
  .planes-showcase-box {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }

  .planes-header {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .speed-switcher {
    display: flex;
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border);
    padding: 0.35rem;
    border-radius: var(--radius-full);
    gap: 0.35rem;
  }

  .plan-tab {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 0.65rem 1.5rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.925rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .plan-tab.active {
    background-color: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(227, 6, 19, 0.3);
  }

  .planes-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .speed-title-box {
    margin-bottom: 1.25rem;
  }

  .plan-title-text {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-dark-heading);
  }

  .plan-desc-text {
    font-size: 1.05rem;
    color: var(--color-text-body);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .plan-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .plan-benefits-card {
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.25rem;
  }

  .plan-benefits-card h4 {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    color: var(--color-dark-heading);
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .benefits-list li {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-dark);
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  @media (max-width: 992px) {
    .planes-content {
      grid-template-columns: 1fr;
    }
    .speed-switcher {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.plan-tab');
  const titleVal = document.getElementById('planTitleVal');
  const descText = document.getElementById('planDescText');

  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      tabs.forEach(t => t.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');

      const title = target.getAttribute('data-title');
      const desc = target.getAttribute('data-desc');

      if (titleVal && title) titleVal.textContent = title;
      if (descText && desc) descText.textContent = desc;
    });
  });
</script>
