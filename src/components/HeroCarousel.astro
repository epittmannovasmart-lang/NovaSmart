---
const slides = [
  {
    badge: "ORGULLOSAMENTE PERUANOS",
    title: "Un Gran Equipo Humano",
    highlight: "CONECTANDO AL PERÚ",
    subtitle: "Distribuidor Autorizado Claro comprometido con la excelencia, calidad y desarrollo de nuestras familias y empresas.",
    image: "/images/equipo/administracion_2.jpg",
    focalPoint: "center 45%",
    bgSize: "cover",
    promoPill: "Compromiso, Calidad y Orgullo Nacional"
  },
  {
    badge: "CLARO ES LA FIBRA QUE TE DA MÁS",
    title: "Instalación 100% Fibra",
    highlight: "EN MENOS DE 24 HORAS",
    subtitle: "Acércate a nuestro centro de atención y venta más cercano. Presencia en Real Plaza Puruchuco, Mall Plaza Surquillo, CC Mall Aventura SJL y más.",
    image: "/images/equipo/tecnicos_1.jpg",
    focalPoint: "center 22%",
    bgSize: "cover",
    promoPill: "Atención Especializada y Cobertura Garantizada"
  },
  {
    badge: "OFERTA EXCLUSIVA 2 PLAY",
    title: "Fibra Óptica + Claro TV+",
    highlight: "400 Mbps FIBRA SIMÉTRICA",
    subtitle: "Velocidad de 400 Mbps por 6 meses con descuento por 4 meses. Incluye L1 MAX para que no te pierdas ningún partido.",
    image: "/images/equipo/tienda_1.jpg",
    focalPoint: "center 45%",
    bgSize: "cover",
    promoPill: "Incluye L1 MAX + Claro TV+"
  },
  {
    badge: "CULTURA Y TRABAJO EN EQUIPO",
    title: "Talento y Pasión",
    highlight: "AL SERVICIO DE NUESTROS CLIENTES",
    subtitle: "Atención personalizada en tiendas, soporte telefónico continuo 24/7 y despliegue técnico a nivel nacional.",
    image: "/images/equipo/administracion_1.jpg",
    focalPoint: "center 48%",
    bgSize: "cover",
    promoPill: "Atención Cercana y Soluciones Inmediatas"
  }
];
---

<section id="inicio" class="hero-carousel-section">
  <div class="carousel-track" id="carouselTrack">
    {slides.map((slide, index) => (
      <div 
        class={`carousel-slide ${index === 0 ? 'active' : ''}`} 
        data-slide-index={index}
      >
        <!-- Ambient Blur Background -->
        <div 
          class="slide-bg-blur" 
          style={`background-image: url('${slide.image}');`}
        ></div>

        <!-- Background Image -->
        <div 
          class="slide-bg-img" 
          style={`background-image: url('${slide.image}'); background-position: ${slide.focalPoint}; background-size: ${slide.bgSize || 'cover'};`}
        ></div>

        <!-- Gradient overlay -->
        <div class="slide-overlay"></div>

        <!-- Content -->
        <div class="container slide-container">
          <div class="slide-content">
            <div class="badge badge-claro-banner">
              <span class="dot-pulse"></span>
              <span>{slide.badge}</span>
            </div>

            <h1 class="slide-title">
              {slide.title} <br />
              <span class="slide-highlight">{slide.highlight}</span>
            </h1>

            <p class="slide-subtitle">{slide.subtitle}</p>

            <div class="slide-actions">
              <a href="#planes" class="btn btn-primary btn-hero">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                <span>Ver Planes de Fibra</span>
              </a>
              <a href="#contacto" class="btn btn-outline-hero">
                <span>Contactar Asesor</span>
              </a>
            </div>

            <div class="slide-pill-tag">
              <span>{slide.promoPill}</span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Carousel Controls -->
  <div class="container controls-container">
    <div class="carousel-nav-bar">
      <button class="nav-arrow prev-arrow" id="prevSlideBtn" aria-label="Anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="nav-arrow next-arrow" id="nextSlideBtn" aria-label="Siguiente">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <div class="carousel-dots" id="carouselDots">
        {slides.map((_, idx) => (
          <button class={`dot-item ${idx === 0 ? 'active' : ''}`} data-dot-index={idx} aria-label={`Diapositiva ${idx + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-carousel-section {
    position: relative;
    width: 100%;
    min-height: 620px;
    height: 75vh;
    max-height: 700px;
    background-color: #0F172A;
    overflow: hidden;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }

  .carousel-slide.active {
    display: block;
    opacity: 1;
  }

  .slide-bg-blur {
    position: absolute;
    top: -5%;
    left: -5%;
    width: 110%;
    height: 110%;
    background-size: cover;
    background-position: center;
    filter: blur(30px) brightness(0.4);
    opacity: 0.5;
    z-index: 0;
  }

  .slide-bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-repeat: no-repeat;
    z-index: 1;
    transition: transform 10s ease-out;
  }

  .carousel-slide.active .slide-bg-img {
    transform: scale(1.04);
  }

  .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(270deg,
        rgba(15, 23, 42, 0.92) 0%,
        rgba(15, 23, 42, 0.75) 45%,
        rgba(15, 23, 42, 0.40) 70%,
        rgba(0, 0, 0, 0.05) 100%
      );
    z-index: 2;
  }

  .slide-container {
    position: relative;
    z-index: 5;
    height: 100%;
    width: 100%;
    max-width: 100% !important;
    padding-left: 2rem;
    padding-right: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .slide-content {
    max-width: 580px;
    width: 100%;
    color: #FFFFFF;
    text-align: right;
    margin-left: auto;
    margin-right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .badge-claro-banner {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
    align-self: flex-end;
  }

  .slide-title {
    font-size: 3.4rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 1rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-align: right;
    width: 100%;
  }

  .slide-highlight {
    background: linear-gradient(135deg, #FF6666 0%, #FF2222 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 20px rgba(255, 34, 34, 0.3);
  }

  .slide-subtitle {
    font-size: 1.1rem;
    color: #F1F5F9;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    text-align: right;
    width: 100%;
  }

  .slide-pill-tag {
    display: inline-flex;
    background: rgba(238, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 700;
    align-self: flex-end;
  }

  .slide-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-hero {
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-size: 1rem;
    padding: 0.85rem 1.8rem;
    box-shadow: 0 8px 25px rgba(227, 6, 19, 0.4);
  }

  .btn-hero:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 30px rgba(227, 6, 19, 0.6);
  }

  .btn-outline-hero {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    transition: all 0.3s ease;
  }

  .btn-outline-hero:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  /* Controls */
  .controls-container {
    position: absolute;
    bottom: 2rem;
    left: 1.5rem;
    z-index: 10;
  }

  .carousel-nav-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .nav-arrow:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .carousel-dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot-item {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot-item.active {
    width: 32px;
    border-radius: 6px;
    background: #EE0000;
    box-shadow: 0 0 10px #EE0000;
  }

  @media (max-width: 1024px) {
    .selector-container {
      position: relative;
      top: 0;
      right: 0;
      transform: none;
      justify-content: center;
      margin-top: 2rem;
      padding-bottom: 4rem;
    }
    .hero-carousel-section {
      min-height: auto;
      height: auto;
    }
    .carousel-track {
      height: 480px;
    }
    .slide-title {
      font-size: 2.3rem;
    }
  }
</style>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('.dot-item');
  const prevBtn = document.getElementById('prevSlideBtn');
  const nextBtn = document.getElementById('nextSlideBtn');
  let autoTimer: any = null;

  function showSlide(index: number) {
    if (slides.length === 0) return;
    slides.forEach(s => {
      (s as HTMLElement).style.display = 'none';
      s.classList.remove('active');
    });
    dots.forEach(d => d.classList.remove('active'));

    currentSlide = (index + slides.length) % slides.length;
    const activeSlide = slides[currentSlide] as HTMLElement;
    if (activeSlide) {
      activeSlide.style.display = 'block';
      setTimeout(() => activeSlide.classList.add('active'), 20);
    }
    dots[currentSlide]?.classList.add('active');
  }

  function nextSlide() {
    showSlide(currentSlide + 1);
  }

  function startAutoPlay() {
    stopAutoPlay();
    autoTimer = setInterval(nextSlide, 5000);
  }

  function stopAutoPlay() {
    if (autoTimer) clearInterval(autoTimer);
  }

  prevBtn?.addEventListener('click', () => {
    showSlide(currentSlide - 1);
    startAutoPlay();
  });

  nextBtn?.addEventListener('click', () => {
    nextSlide();
    startAutoPlay();
  });

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-dot-index') || '0');
      showSlide(idx);
      startAutoPlay();
    });
  });

  startAutoPlay();
</script>
