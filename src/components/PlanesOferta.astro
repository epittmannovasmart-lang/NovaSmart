---
import promocionesData from '../data/promociones.json';
const { modalidades } = promocionesData;
const salesPhone = "51983985748";

const subcategories2Play = [
  { id: 'tv', label: 'Internet + TV', filter: (p: any) => p.speed.includes('TV') },
  { id: 'telf', label: 'Internet + Telefonía', filter: (p: any) => p.speed.includes('Telefonía') },
];
---

<section id="planes" class="section-padding planes-section">
  <div class="container">
    <div class="section-header text-center reveal">
      <span class="badge badge-red">{promocionesData.vigencia}</span>
      <h2 class="section-title">Planes y Ofertas Claro Fibra Óptica</h2>
      <p class="section-description">
        Catálogo técnico y comercial de promociones vigentes. Explora los servicios 1 Play, 2 Play, 3 Play y Ofertas Focalizadas con bonos de velocidad y beneficios exclusivos.
      </p>
    </div>

    <div class="planes-showcase-box reveal reveal-delay-1">
      <div class="planes-header">
        <div class="speed-switcher">
          {modalidades.map((m, idx) => (
            <button
              class={`plan-tab ${idx === 0 ? 'active' : ''}`}
              data-mod-id={m.id}
            >
              {m.tabName}
            </button>
          ))}
        </div>
      </div>

      {modalidades.map((m, mIdx) => {
        const hasSubcats = m.id === '2play';
        const planes2PlayTV = hasSubcats ? m.planes.filter((p: any) => p.speed.includes('TV')) : [];
        const planes2PlayTelf = hasSubcats ? m.planes.filter((p: any) => p.speed.includes('Telefonía')) : [];

        return (
          <div class={`modality-panel ${mIdx === 0 ? 'active' : ''}`} id={`modality-${m.id}`}>
            <div class="modality-intro text-center">
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
            </div>

            <div class="modality-promo-banner">
              <div class="banner-badge-box">
                <span class="banner-pill">OFERTA CAMPAÑA VIGENTE</span>
              </div>
              <h4 class="banner-title">{m.promoGeneralTitle}</h4>
              <p class="banner-text">{m.promoGeneralText}</p>
            </div>

            {hasSubcats ? (
              <div class="subcat-section">
                <div class="subcat-tabs">
                  {subcategories2Play.map((sc, scIdx) => (
                    <button
                      class={`subcat-tab ${scIdx === 0 ? 'active' : ''}`}
                      data-subcat={sc.id}
                      data-parent-mod={m.id}
                    >
                      {sc.label}
                      <span class="subcat-count">{sc.id === 'tv' ? planes2PlayTV.length : planes2PlayTelf.length}</span>
                    </button>
                  ))}
                </div>

                <div class="subcat-panel active" id={`subcat-${m.id}-tv`}>
                  <div class="plans-carousel-wrapper">
                    <button class="carousel-arrow prev-plan-btn" aria-label="Anterior">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                    </button>
                    <div class="cards-grid-viewport">
                      <div class="cards-grid-track">
                        {planes2PlayTV.map((p: any) => {
                          const whatsappMsg = `Hola, deseo consultar disponibilidad sobre el ${p.speed} (${m.tabName}).`;
                          const whatsappLink = `https://wa.me/${salesPhone}?text=${encodeURIComponent(whatsappMsg)}`;
                          return (
                            <div class="claro-plan-card">
                              <div class="card-top-badge"><span>OFERTA VIGENTE</span></div>
                              <div class="card-modality-header">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                                <span>Fibra Óptica Simétrica</span>
                              </div>
                              <h4 class="card-plan-title">
                                {p.speed}
                                <span class="card-tag-badge">{p.tag}</span>
                              </h4>
                              <div class="card-price-block">
                                <span class="card-price">{p.price}</span>
                                {p.priceNote && <span class="card-price-note">{p.priceNote}</span>}
                                {p.regularPrice && <span class="card-regular-price">Regular {p.regularPrice}</span>}
                              </div>
                              <div class="card-specs-list">
                                <div class="spec-row">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                  <span><strong>Bono:</strong> {p.fullClaroSpeed}</span>
                                </div>
                                {p.entretenimiento && (
                                  <div class="spec-row">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
                                    <span><strong>TV / Contenido:</strong> {p.entretenimiento}</span>
                                  </div>
                                )}
                              </div>
                              {p.features && p.features.length > 0 && (
                                <div class="card-highlight-strip">
                                  <span class="strip-label">BENEFICIO DESTACADO</span>
                                  <strong class="strip-value">{p.features[0]}</strong>
                                </div>
                              )}
                              <div class="card-action-box">
                                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger btn-block">
                                  <span>Solicitar</span>
                                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </a>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                    <button class="carousel-arrow next-plan-btn" aria-label="Siguiente">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                    </button>
                  </div>
                  <div class="plan-dots-nav"></div>
                </div>

                <div class="subcat-panel" id={`subcat-${m.id}-telf`}>
                  <div class="plans-carousel-wrapper">
                    <button class="carousel-arrow prev-plan-btn" aria-label="Anterior">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                    </button>
                    <div class="cards-grid-viewport">
                      <div class="cards-grid-track">
                        {planes2PlayTelf.map((p: any) => {
                          const whatsappMsg = `Hola, deseo consultar disponibilidad sobre el ${p.speed} (${m.tabName}).`;
                          const whatsappLink = `https://wa.me/${salesPhone}?text=${encodeURIComponent(whatsappMsg)}`;
                          return (
                            <div class="claro-plan-card">
                              <div class="card-top-badge"><span>OFERTA VIGENTE</span></div>
                              <div class="card-modality-header">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                                <span>Fibra Óptica Simétrica</span>
                              </div>
                              <h4 class="card-plan-title">
                                {p.speed}
                                <span class="card-tag-badge">{p.tag}</span>
                              </h4>
                              <div class="card-price-block">
                                <span class="card-price">{p.price}</span>
                                {p.priceNote && <span class="card-price-note">{p.priceNote}</span>}
                                {p.regularPrice && <span class="card-regular-price">Regular {p.regularPrice}</span>}
                              </div>
                              <div class="card-specs-list">
                                <div class="spec-row">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                  <span><strong>Bono:</strong> {p.fullClaroSpeed}</span>
                                </div>
                                {p.entretenimiento && (
                                  <div class="spec-row">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
                                    <span><strong>TV / Contenido:</strong> {p.entretenimiento}</span>
                                  </div>
                                )}
                              </div>
                              {p.features && p.features.length > 0 && (
                                <div class="card-highlight-strip">
                                  <span class="strip-label">BENEFICIO DESTACADO</span>
                                  <strong class="strip-value">{p.features[0]}</strong>
                                </div>
                              )}
                              <div class="card-action-box">
                                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger btn-block">
                                  <span>Solicitar</span>
                                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                </a>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                    <button class="carousel-arrow next-plan-btn" aria-label="Siguiente">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                    </button>
                  </div>
                  <div class="plan-dots-nav"></div>
                </div>
              </div>
            ) : (
              <div class="plans-carousel-wrapper">
                <button class="carousel-arrow prev-plan-btn" aria-label="Anterior">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <div class="cards-grid-viewport">
                  <div class="cards-grid-track">
                    {m.planes.map((p: any) => {
                      const whatsappMsg = `Hola, deseo consultar disponibilidad sobre el ${p.speed} (${m.tabName}).`;
                      const whatsappLink = `https://wa.me/${salesPhone}?text=${encodeURIComponent(whatsappMsg)}`;
                      return (
                        <div class="claro-plan-card">
                          <div class="card-top-badge"><span>OFERTA VIGENTE</span></div>
                          <div class="card-modality-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                            <span>Fibra Óptica Simétrica</span>
                          </div>
                          <h4 class="card-plan-title">
                            {p.speed}
                            <span class="card-tag-badge">{p.tag}</span>
                          </h4>
                          <div class="card-price-block">
                            <span class="card-price">{p.price}</span>
                            {p.priceNote && <span class="card-price-note">{p.priceNote}</span>}
                            {p.regularPrice && <span class="card-regular-price">Regular {p.regularPrice}</span>}
                          </div>
                          <div class="card-specs-list">
                            <div class="spec-row">
                              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                              <span><strong>Bono:</strong> {p.fullClaroSpeed}</span>
                            </div>
                            {(p as any).equipos && (
                              <div class="spec-row">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                                <span><strong>Equipos:</strong> {(p as any).equipos}</span>
                              </div>
                            )}
                            {(p as any).entretenimiento && (
                              <div class="spec-row">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
                                <span><strong>TV / Contenido:</strong> {(p as any).entretenimiento}</span>
                              </div>
                            )}
                          </div>
                          {p.features && p.features.length > 0 && (
                            <div class="card-highlight-strip">
                              <span class="strip-label">BENEFICIO DESTACADO</span>
                              <strong class="strip-value">{p.features[0]}</strong>
                            </div>
                          )}
                          <div class="card-action-box">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger btn-block">
                              <span>Solicitar</span>
                              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                            </a>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
                <button class="carousel-arrow next-plan-btn" aria-label="Siguiente">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>
            )}
            {!hasSubcats && <div class="plan-dots-nav"></div>}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .planes-section {
    background-color: var(--color-bg-light);
  }

  .section-header {
    max-width: 900px;
    margin: 0 auto 4.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header .badge {
    margin-bottom: 1.5rem;
    padding: 0.55rem 1.5rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: 2.75rem;
    font-weight: 900;
    margin: 0 0 1.25rem 0;
    line-height: 1.2;
    color: var(--color-dark-heading);
  }

  .section-description {
    font-size: 1.15rem;
    color: var(--color-text-body);
    line-height: 1.7;
    max-width: 820px;
    margin: 0 auto;
  }

  .planes-showcase-box {
    background-color: #FAFAFB;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 4rem 3rem;
    box-shadow: var(--shadow-md);
  }

  .planes-header {
    display: flex;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .speed-switcher {
    display: inline-flex;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.5rem;
    border-radius: var(--radius-full);
    gap: 0.65rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    flex-wrap: wrap;
    justify-content: center;
  }

  .plan-tab {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 0.85rem 2.25rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.975rem;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .plan-tab.active {
    background-color: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 4px 16px rgba(227, 6, 19, 0.35);
  }

  .modality-panel {
    display: none;
  }

  .modality-panel.active {
    display: block;
  }

  .modality-intro {
    text-align: center;
    margin-bottom: 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .modality-intro h3 {
    font-size: 2rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
    color: var(--color-dark-heading);
    text-align: center;
    line-height: 1.25;
  }

  .modality-intro p {
    font-size: 1.1rem;
    color: var(--color-text-body);
    margin: 0 auto;
    max-width: 760px;
    text-align: center;
    line-height: 1.7;
  }

  .modality-promo-banner {
    background: #FFF5F5;
    border: 1px solid rgba(227, 6, 19, 0.2);
    border-radius: var(--radius-md);
    padding: 2rem 2.5rem;
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .banner-badge-box {
    margin-bottom: 0.25rem;
  }

  .banner-pill {
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 1.1rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .banner-title {
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 0;
    line-height: 1.35;
  }

  .banner-text {
    font-size: 1.025rem;
    color: var(--color-dark-heading);
    margin: 0 auto;
    max-width: 820px;
    line-height: 1.65;
    font-weight: 600;
  }

  /* Subcategories */
  .subcat-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .subcat-tabs {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .subcat-tab {
    background: #FFFFFF;
    border: 2px solid var(--color-border);
    color: var(--color-text-muted);
    padding: 0.7rem 1.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .subcat-tab:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .subcat-tab.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(227, 6, 19, 0.25);
  }

  .subcat-count {
    background: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    min-width: 20px;
    text-align: center;
  }

  .subcat-tab:not(.active) .subcat-count {
    background: rgba(227, 6, 19, 0.1);
    color: var(--color-primary);
  }

  .subcat-panel {
    display: none;
  }

  .subcat-panel.active {
    display: block;
  }

  /* Carousel */
  .plans-carousel-wrapper {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    position: relative;
  }

  .carousel-arrow {
    background: #FFFFFF;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(227, 6, 19, 0.15);
    z-index: 5;
  }

  .carousel-arrow:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
    transform: scale(1.1);
  }

  .cards-grid-viewport {
    flex: 1;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 1.25rem 0.25rem 0.5rem;
    scrollbar-width: none;
  }

  .cards-grid-viewport::-webkit-scrollbar {
    display: none;
  }

  .cards-grid-track {
    display: flex;
    gap: 1.5rem;
  }

  /* Card */
  .claro-plan-card {
    flex: 0 0 calc(25% - 1.125rem);
    min-width: 220px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    padding: 1.5rem 1.25rem 1.25rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    margin-top: 12px;
  }

  .claro-plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
  }

  .claro-plan-card:hover .card-top-badge {
    transform: translateX(-50%) scale(1.05);
    box-shadow: 0 6px 18px rgba(227, 6, 19, 0.5);
  }

  .card-top-badge {
    position: absolute;
    top: -12px;
    left: 50%;
