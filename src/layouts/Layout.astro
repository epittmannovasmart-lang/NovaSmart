---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; minimalHeader?: boolean; }
const { title = 'NovaSmart | Conectamos lo que importa', description = 'Fibra para el hogar, servicios móviles, tecnología y soporte de NovaSmart.', minimalHeader = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10182f" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo_ns.png" />
    <link rel="apple-touch-icon" href="/images/logo_ns.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body><Header minimal={minimalHeader} /><main><slot /></main><Footer /></body>
</html>
