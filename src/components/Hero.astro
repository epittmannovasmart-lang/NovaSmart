---
---

<section id="inicio" class="hero-section">
  <div class="hero-bg" style="background-image: url('/images/hero_banner.jpg');"></div>
  <div class="hero-overlay"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="badge badge-red hero-badge">
        <span>Consorcio con Claro Perú</span>
      </div>

      <h1 class="hero-title">
        Conectamos Hogares y Empresas con <span class="highlight-red">Telecomunicaciones de Vanguardia</span>
      </h1>

      <p class="hero-subtitle">
        En <strong>Nova Smart</strong> lideramos proyectos de instalación, mantenimiento y despliegue de fibra óptica (FTTH/HFC) a nivel nacional, garantizando altos estándares de calidad y efectividad técnica.
      </p>

      <div class="hero-ctas">
        <a href="#servicios" class="btn btn-primary">
          <span>Ver Nuestros Servicios</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#trabajos" class="btn btn-outline">
          <span>Sumamos Talento</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bar de Impacto / Métricas -->
  <div class="container">
    <div class="stats-bar">
      <div class="stat-item">
        <span class="stat-number">+50,000</span>
        <span class="stat-label">Conexiones Realizadas</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">99.8%</span>
        <span class="stat-label">Eficiencia Operativa</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">24 / 7</span>
        <span class="stat-label">Soporte y Emergencias</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 5rem 0 3rem;
    background-color: var(--color-bg-light);
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.88) 55%, rgba(255, 255, 255, 0.4) 100%);
    z-index: 2;
  }

  .hero-container {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    min-height: 440px;
    margin-bottom: 2rem;
  }

  .hero-content {
    max-width: 680px;
  }

  .hero-badge {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-dark-heading);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .highlight-red {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-body);
    margin-bottom: 2rem;
    line-height: 1.65;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Stats Bar */
  .stats-bar {
    position: relative;
    z-index: 4;
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 1.75rem 2.5rem;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-around;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 45px;
    background-color: var(--color-border);
  }

  @media (max-width: 992px) {
    .hero-title {
      font-size: 2.4rem;
    }
    .hero-overlay {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 100%);
    }
    .stats-bar {
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.5rem;
    }
    .stat-divider {
      display: none;
    }
  }
</style>
