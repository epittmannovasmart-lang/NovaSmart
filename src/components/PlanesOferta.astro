</style>

<script>
  function initPlanesOfota() {
    const tabs = document.querySelectorAll('.plan-tab');
    const panels = document.querySelectorAll('.modality-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        const modId = target.getAttribute('data-mod-id');
        const activePanel = document.getElementById(`modality-${modId}`);
        if (activePanel) {
          activePanel.classList.add('active');
          requestAnimationFrame(() => setupCarousels(activePanel));
        }
      });
    });

    const subcatTabs = document.querySelectorAll('.subcat-tab');
    subcatTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const parentMod = target.getAttribute('data-parent-mod');
        const subcatId = target.getAttribute('data-subcat');
        const parentPanel = document.getElementById(`modality-${parentMod}`);
        if (!parentPanel) return;
        parentPanel.querySelectorAll('.subcat-tab').forEach(t => t.classList.remove('active'));
        parentPanel.querySelectorAll('.subcat-panel').forEach(p => p.classList.remove('active'));
        target.classList.add('active');
        const panel = document.getElementById(`subcat-${parentMod}-${subcatId}`);
        if (panel) {
          panel.classList.add('active');
          requestAnimationFrame(() => setupCarousels(panel));
        }
      });
    });

    function setupCarousels(container: HTMLElement) {
      container.querySelectorAll('.plans-carousel-wrapper').forEach(initCarousel);
    }

    function initCarousel(wrapper: Element) {
      const viewport = wrapper.querySelector('.cards-grid-viewport') as HTMLElement;
      const track = wrapper.querySelector('.cards-grid-track') as HTMLElement;
      const prevBtn = wrapper.querySelector('.prev-plan-btn') as HTMLElement;
      const nextBtn = wrapper.querySelector('.next-plan-btn') as HTMLElement;

      if (!viewport || !track) return;

      viewport.scrollLeft = 0;

      function updateArrows() {
        const maxScroll = viewport.scrollWidth - viewport.clientWidth;
        const atStart = viewport.scrollLeft <= 5;
        const atEnd = viewport.scrollLeft >= maxScroll - 5;
        if (prevBtn) prevBtn.style.display = atStart ? 'none' : '';
        if (nextBtn) nextBtn.style.display = atEnd ? 'none' : '';
      }

      function scrollByAmount(dir: number) {
        const cardWidth = track.children[0] ? (track.children[0] as HTMLElement).offsetWidth + 24 : 300;
        viewport.scrollBy({ left: dir * cardWidth * 2, behavior: 'smooth' });
      }

      prevBtn?.replaceWith(prevBtn.cloneNode(true));
      nextBtn?.replaceWith(nextBtn.cloneNode(true));
      const newPrev = wrapper.querySelector('.prev-plan-btn');
      const newNext = wrapper.querySelector('.next-plan-btn');

      newPrev?.addEventListener('click', () => scrollByAmount(-1));
      newNext?.addEventListener('click', () => scrollByAmount(1));

      viewport.addEventListener('scroll', updateArrows, { passive: true });
      updateArrows();
    }

    document.querySelectorAll('.modality-panel.active').forEach(panel => {
      setupCarousels(panel as HTMLElement);
    });
  }

  document.addEventListener('DOMContentLoaded', initPlanesOfota);
  document.addEventListener('astro:page-load', initPlanesOfota);
</script>
