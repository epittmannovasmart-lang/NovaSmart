---
const slides = [
  {
    badge: "DISTRIBUIDOR AUTORIZADO CLARO PERÚ",
    title: "Un Gran Equipo Humano",
    highlight: "CONECTANDO AL PERÚ",
    subtitle: "Distribuidor Autorizado Claro comprometido con la excelencia, calidad y desarrollo de nuestras familias y empresas.",
    image: "/images/equipo/administracion_2.jpg",
    focalPoint: "center 45%",
    bgSize: "cover",
    promoPill: "Compromiso, Calidad y Orgullo Nacional"
  },
  {
    badge: "COBERTURA Y ATENCIÓN ESPECIALIZADA",
    title: "Instalación 100% Fibra",
    highlight: "CON RESPALDO Y GARANTÍA",
    subtitle: "Acércate a nuestras sedes y puntos de atención autorizados. Cobertura técnica y asesoría personalizada para tu hogar o negocio.",
    image: "/images/equipo/tecnicos_1.jpg",
    focalPoint: "center 22%",
    bgSize: "cover",
    promoPill: "Atención Especializada y Cobertura Garantizada"
  },
  {
    badge: "MODALIDADES Y COMBOS VIGENTES",
    title: "Fibra Óptica Simétrica",
    highlight: "MÁXIMA VELOCIDAD Y ENTRETENIMIENTO",
    subtitle: "Conoce nuestros combos residenciales y corporativos 1 Play, 2 Play y 3 Play con bonos de velocidad y beneficios integrados.",
    image: "/images/equipo/tienda_1.jpg",
    focalPoint: "center 45%",
    bgSize: "cover",
    promoPill: "Planes Residenciales y Corporativos"
  },
  {
    badge: "CULTURA Y TRABAJO EN EQUIPO",
    title: "Talento y Pasión",
    highlight: "AL SERVICIO DE NUESTROS CLIENTES",
    subtitle: "Atención personalizada en tiendas, soporte técnico continuo y despliegue técnico especializado a nivel nacional.",
    image: "/images/equipo/administracion_1.jpg",
    focalPoint: "center 48%",
    bgSize: "cover",
    promoPill: "Atención Cercana y Soluciones Inmediatas"
  }
];
---

<section id="inicio" class="hero-carousel-section">
  <div class="carousel-track" id="carouselTrack">
    {slides.map((slide, index) => (
      <div 
        class={`carousel-slide ${index === 0 ? 'active' : ''}`} 
        data-slide-index={index}
      >
        <!-- Ambient Blur Background -->
        <div 
          class="slide-bg-blur" 
          style={`background-image: url('${slide.image}');`}
        ></div>

        <!-- Background Image -->
        <div 
          class="slide-bg-image" 
          style={`background-image: url('${slide.image}'); background-position: ${slide.focalPoint}; background-size: ${slide.bgSize};`}
        ></div>

        <!-- Dark Gradient Overlay (Right edge focused text) -->
        <div class="slide-overlay"></div>

        <!-- Content Container (Right Edge Aligned) -->
        <div class="slide-container">
          <div class="slide-content">
            <span class="badge badge-red slide-badge">{slide.badge}</span>
            <h1 class="slide-title">
              {slide.title} <br />
              <span class="highlight-text">{slide.highlight}</span>
            </h1>
            <p class="slide-subtitle">{slide.subtitle}</p>

            <div class="slide-actions">
              <a href="#planes" class="btn btn-primary btn-lg">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                <span>Ver Planes de Fibra</span>
              </a>
              <a href="#contacto" class="btn btn-outline-light btn-lg">
                <span>Contactar Asesor</span>
              </a>
            </div>

            <!-- General Timeless Tag Pill -->
            <div class="promo-tag-box">
              <span class="promo-tag-pill">{slide.promoPill}</span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Carousel Controls -->
  <button class="carousel-arrow prev-btn" id="prevSlideBtn" aria-label="Anterior diapositiva">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button class="carousel-arrow next-btn" id="nextSlideBtn" aria-label="Siguiente diapositiva">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
  </button>

  <!-- Dots Navigation -->
  <div class="carousel-dots" id="carouselDots">
    {slides.map((_, index) => (
      <button 
        class={`dot ${index === 0 ? 'active' : ''}`} 
        data-slide-target={index}
        aria-label={`Ir a la diapositiva ${index + 1}`}
      ></button>
    ))}
  </div>
</section>

<style>
  .hero-carousel-section {
    position: relative;
    width: 100%;
    height: 92vh;
    min-height: 620px;
    max-height: 850px;
    overflow: hidden;
    background-color: #0F172A;
  }

  .carousel-track {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    z-index: 1;
  }

  .carousel-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  /* Ambient Blur Background */
  .slide-bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    filter: blur(25px);
    transform: scale(1.1);
    opacity: 0.45;
  }

  /* Background Image */
  .slide-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-repeat: no-repeat;
    transition: transform 7s ease-out;
  }

  .carousel-slide.active .slide-bg-image {
    transform: scale(1.04);
  }

  /* Dark Overlay for Text Contrast on Right */
  .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      270deg,
      rgba(15, 23, 42, 0.95) 0%,
      rgba(15, 23, 42, 0.78) 45%,
      rgba(15, 23, 42, 0.35) 75%,
      rgba(15, 23, 42, 0.15) 100%
    );
  }

  .slide-container {
    height: 100%;
    width: 100%;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    position: relative;
    z-index: 3;
    padding-top: 4rem;
    padding-right: 5rem;
    padding-left: 2rem;
    box-sizing: border-box;
  }

  .slide-content {
    max-width: 580px;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    margin-left: auto;
  }

  .slide-badge {
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    animation: fadeInDown 0.6s ease forwards;
  }

  .slide-title {
    font-size: clamp(2.3rem, 4.5vw, 3.75rem);
    font-weight: 900;
    line-height: 1.15;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    animation: fadeInUp 0.7s ease forwards;
  }

  .highlight-text {
    background: linear-gradient(135deg, #FF6B6B 0%, #E30613 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .slide-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: #E2E8F0;
    margin-bottom: 2.25rem;
    max-width: 600px;
    animation: fadeInUp 0.8s ease forwards;
  }

  .slide-actions {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-bottom: 1.75rem;
    animation: fadeInUp 0.9s ease forwards;
  }

  .promo-tag-box {
    margin-top: 0.5rem;
    animation: fadeInUp 1s ease forwards;
  }

  .promo-tag-pill {
    display: inline-block;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.45rem 1.25rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  /* Carousel Navigation Arrows */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(6px);
  }

  .carousel-arrow:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 0 20px rgba(227, 6, 19, 0.5);
  }

  .prev-btn {
    left: 2rem;
  }

  .next-btn {
    right: 2rem;
  }

  /* Dots Navigation */
  .carousel-dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 0.75rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: var(--color-primary);
    width: 36px;
    border-radius: var(--radius-full);
    box-shadow: 0 0 10px rgba(227, 6, 19, 0.6);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 992px) {
    .slide-container {
      padding-right: 1.5rem;
    }
    .slide-content {
      align-items: center;
      text-align: center;
    }
    .slide-actions {
      justify-content: center;
    }
    .carousel-arrow {
      width: 44px;
      height: 44px;
    }
    .prev-btn {
      left: 1rem;
    }
    .next-btn {
      right: 1rem;
    }
  }
</style>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('.dot');
  const totalSlides = slides.length;
  let autoplayTimer: ReturnType<typeof setInterval>;

  function showSlide(index: number) {
    slides.forEach((slide) => slide.classList.remove('active'));
    dots.forEach((dot) => dot.classList.remove('active'));

    currentSlide = (index + totalSlides) % totalSlides;

    slides[currentSlide].classList.add('active');
    dots[currentSlide].classList.add('active');
  }

  function nextSlide() {
    showSlide(currentSlide + 1);
  }

  function prevSlide() {
    showSlide(currentSlide - 1);
  }

  function startAutoplay() {
    stopAutoplay();
    autoplayTimer = setInterval(nextSlide, 6000);
  }

  function stopAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
  }

  document.getElementById('nextSlideBtn')?.addEventListener('click', () => {
    nextSlide();
    startAutoplay();
  });

  document.getElementById('prevSlideBtn')?.addEventListener('click', () => {
    prevSlide();
    startAutoplay();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const index = parseInt(target.getAttribute('data-slide-target') || '0', 10);
      showSlide(index);
      startAutoplay();
    });
  });

  // Start carousel
  startAutoplay();
</script>
