<style>
  /* Consideraciones */
  .footer-consideraciones {
    background-color: #F1F5F9;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 2rem 0;
  }

  .consideraciones-box {
    max-width: 1050px;
    margin: 0 auto;
  }

  .consideraciones-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
    margin-bottom: 1rem;
  }

  .consideraciones-details {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .consideraciones-summary {
    padding: 1rem 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: #1E293B;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    list-style: none;
  }

  .consideraciones-summary::-webkit-details-marker {
    display: none;
  }

  .chevron-icon {
    transition: transform 0.25s ease;
  }

  .consideraciones-details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .consideraciones-text {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.65;
    border-top: 1px solid #F1F5F9;
  }

  /* Mega Footer */
  .footer {
    background-color: #111827;
    color: #9CA3AF;
    padding: 3.5rem 0 2rem;
    font-family: var(--font-body);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid #1F2937;
  }

  .col-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 1.2rem;
    letter-spacing: 0.02em;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col-links a {
    color: #9CA3AF;
    font-size: 0.825rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .col-links a:hover {
    color: #FFFFFF;
  }

  /* Middle Bar */
  .footer-middle-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 0;
    border-bottom: 1px solid #1F2937;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .brand-badge-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-brand-logo {
    height: 32px;
    width: auto;
    background: #FFFFFF;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .consorcio-badge {
    display: flex;
    flex-direction: column;
    font-size: 0.72rem;
    color: #9CA3AF;
    border-left: 2px solid #E30613;
    padding-left: 0.75rem;
  }

  .consorcio-badge strong {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.82rem;
  }

  .footer-socials {
    display: flex;
    gap: 0.85rem;
  }

  .footer-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #1F2937;
    color: #D1D5DB;
    border-radius: 50%;
    transition: all 0.25s ease;
  }

  .footer-socials a:hover {
    background: #E30613;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .libro-reclamaciones-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #1F2937;
    border: 1px solid #374151;
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .libro-reclamaciones-link:hover {
    background: #374151;
    border-color: #4B5563;
  }

  /* Bottom Bar */
  .footer-bottom-legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.75rem;
    font-size: 0.78rem;
    color: #6B7280;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .copyright-text {
    margin: 0;
  }

  .legal-links {
    display: flex;
    gap: 1.25rem;
  }

  .legal-links a {
    color: #6B7280;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .legal-links a:hover {
    color: #D1D5DB;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 1.75rem;
    }
    .footer-middle-bar,
    .footer-bottom-legal {
      flex-direction: column;
      text-align: center;
    }
    .brand-badge-group {
      flex-direction: column;
      gap: 0.5rem;
    }
    .consorcio-badge {
      border-left: none;
      padding-left: 0;
    }
  }
</style>

