---
interface Props {
  subpage?: boolean;
}

const { subpage = false } = Astro.props;
const prefix = subpage ? '/' : '';
---

<!-- Sección de Consideraciones Legal (Estilo Claro) -->
<section class="footer-consideraciones">
  <div class="container">
    <div class="consideraciones-box">
      <h3 class="consideraciones-title">Hablando Claro sobre nuestros servicios</h3>
      <details class="consideraciones-details" open>
        <summary class="consideraciones-summary">
          <span>Consideraciones y Términos de Servicio</span>
          <svg class="chevron-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="consideraciones-text">
          En relación a la información de cobertura y planes proporcionada mediante la presente plataforma web, <strong>Nova Smart</strong> (distribuidor y consorcio autorizado de <strong>Claro Perú</strong>) cumple con informar que la disponibilidad de Fibra Óptica (FTTH/HFC) está sujeta a validación y factibilidad técnica en el predio del usuario. Las velocidades mostradas son simétricas según el plan contratado. La señal y cobertura son referenciales y sujetas a condiciones técnicas del inmueble.
        </div>
      </details>
    </div>
  </div>
</section>

<!-- Footer Mega 5 Columnas -->
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Columna 1 -->
      <div class="footer-col">
        <h4 class="col-title">Servicios Hogar</h4>
        <ul class="col-links">
          <li><a href={`${prefix}contratar-fibra`}>Internet Fibra Óptica</a></li>
          <li><a href={`${prefix}#planes`}>Planes Hogar 1 Solo</a></li>
          <li><a href={`${prefix}#planes`}>Dúo (Internet + TV)</a></li>
          <li><a href={`${prefix}#planes`}>Trío (Internet + TV + Fijo)</a></li>
        </ul>
      </div>

      <!-- Columna 2 -->
      <div class="footer-col">
        <h4 class="col-title">Servicios Móviles</h4>
        <ul class="col-links">
          <li><a href="https://wa.me/51983985748?text=Deseo%20informacion%20sobre%20Portabilidad%20Claro" target="_blank" rel="noopener">Portabilidad Claro</a></li>
          <li><a href="https://wa.me/51983985748?text=Deseo%20informacion%20sobre%20Planes%20Postpago" target="_blank" rel="noopener">Planes Postpago</a></li>
          <li><a href="https://wa.me/51983985748?text=Deseo%20informacion%20sobre%20Renovacion%20de%20Equipos" target="_blank" rel="noopener">Renovación de Equipos</a></li>
          <li><a href="https://wa.me/51983985748?text=Deseo%20informacion%20para%20Empresas%20y%20Pymes" target="_blank" rel="noopener">Soluciones Pyme</a></li>
        </ul>
      </div>

      <!-- Columna 3 -->
      <div class="footer-col">
        <h4 class="col-title">De Utilidad</h4>
        <ul class="col-links">
          <li><a href={`${prefix}visitar-tiendas`}>Consulta de Cobertura</a></li>
          <li><a href={`${prefix}visitar-tiendas`}>Visitar Nuestras Tiendas</a></li>
          <li><a href={`${prefix}atencion-soporte`}>Test de Velocidad</a></li>
          <li><a href={`${prefix}atencion-soporte`}>Comprobantes Electrónicos</a></li>
        </ul>
      </div>

      <!-- Columna 4 -->
      <div class="footer-col">
        <h4 class="col-title">Nos Hacemos Cargo</h4>
        <ul class="col-links">
          <li><a href={`${prefix}atencion-soporte`}>Atención de Reclamos</a></li>
          <li><a href={`${prefix}atencion-soporte`}>Soporte Técnico 24/7</a></li>
          <li><a href={`${prefix}eliminar-datos`}>Solicitud de Eliminar Datos</a></li>
          <li><a href="https://wa.me/51983985748" target="_blank" rel="noopener">Contacto Directo WhatsApp</a></li>
        </ul>
      </div>

      <!-- Columna 5 -->
      <div class="footer-col">
        <h4 class="col-title">Institucional</h4>
        <ul class="col-links">
          <li><a href={`${prefix}#nosotros`}>Sobre Nova Smart</a></li>
          <li><a href={`${prefix}#nosotros`}>Consorcio Claro Perú</a></li>
          <li><a href="/trabajar-nosotros">Trabaja con Nosotros</a></li>
          <li><a href="/privacidad">Política de Privacidad</a></li>
          <li><a href="/terminos">Términos y Condiciones</a></li>
        </ul>
      </div>
    </div>

    <!-- Barra Media: Logos, Redes y Libro de Reclamaciones -->
    <div class="footer-middle-bar">
      <div class="brand-badge-group">
        <a href="/">
          <img src="/logo_oficial.webp" alt="Nova Smart" class="footer-brand-logo" />
        </a>
        <div class="consorcio-badge">
          <span>Distribuidor Autorizado</span>
          <strong>Claro Perú</strong>
        </div>
      </div>

      <div class="footer-socials">
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C20.012 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
