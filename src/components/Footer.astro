---
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1 -->
      <div class="footer-brand">
        <img src="/logo_oficial.jpeg" alt="Nova Smart - Distribuidor Autorizado Claro" class="footer-logo" />
        <p class="brand-desc">
          Empresa peruana especializada en la provisión, instalación y mantenimiento de servicios de telecomunicaciones e infraestructura de fibra óptica.
        </p>
      </div>

      <!-- Col 2 -->
      <div class="footer-col">
        <h4>Navegación</h4>
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#nosotros">Quiénes Somos</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#cobertura">Cobertura</a></li>
          <li><a href="#trabajos">Talento Nova Smart</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <!-- Col 3 -->
      <div class="footer-col">
        <h4>Líneas de Servicio</h4>
        <ul>
          <li>Instalación FTTH / HFC</li>
          <li>Tendido de Fibra Óptica</li>
          <li>Atención de Emergencias 24/7</li>
          <li>Asesoría Comercial Claro</li>
        </ul>
      </div>

      <!-- Col 4 -->
      <div class="footer-col">
        <h4>Portal Privado</h4>
        <p class="intranet-note">Acceso exclusivo para personal administrativo, coordinadores y técnicos.</p>
        <a href="http://localhost:5173" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          <span>Ingresar a Intranet</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Nova Smart Telecomunicaciones. Todos los derechos reservados.</p>
      <div class="legal-links">
        <a href="#">Políticas de Privacidad</a>
        <span>•</span>
        <a href="#">Términos de Servicio</a>
        <span>•</span>
        <a href="#">Normativa OSIPTEL</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #111827;
    color: #9CA3AF;
    padding: 4.5rem 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    background-color: #FFFFFF;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
    display: block;
  }

  .brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #9CA3AF;
  }

  .footer-col h4 {
    color: #FFFFFF;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col a {
    color: #9CA3AF;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #FFFFFF;
  }

  .intranet-note {
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid #1F2937;
    font-size: 0.85rem;
  }

  .legal-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .legal-links a {
    color: #9CA3AF;
  }

  .legal-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
