---

<section id="cobertura" class="section-padding cobertura-section">
  <div class="container">
    <div class="cobertura-box">
      <div class="cobertura-header text-center">
        <span class="badge badge-red">Cobertura en Tiempo Real</span>
        <h2 class="section-title">Verifica la Disponibilidad de Fibra Óptica Claro</h2>
        <p class="section-desc">
          Ingresa tu distrito o ciudad para consultar la cobertura del servicio de Fibra Óptica en tu zona.
        </p>
      </div>

      <div class="search-wrapper">
        <div class="search-form">
          <input 
            type="text" 
            id="districtInput" 
            placeholder="Ej: Los Olivos, San Juan de Lurigancho, Surco, Comas, Ate..." 
            autocomplete="off"
          />
          <button class="btn btn-primary" id="btnCheckCoverage">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Consultar Cobertura</span>
          </button>
        </div>

        <div class="tags-row">
          <span>Distritos populares:</span>
          <button class="chip" data-zone="San Juan de Lurigancho">San Juan de Lurigancho</button>
          <button class="chip" data-zone="Los Olivos">Los Olivos</button>
          <button class="chip" data-zone="Santiago de Surco">Surco</button>
          <button class="chip" data-zone="Comas">Comas</button>
          <button class="chip" data-zone="Miraflores">Miraflores</button>
        </div>
      </div>

      <div class="result-card" id="coverageResult">
        <div class="result-badge">
          <span class="dot-green"></span>
          <span id="coverageBadgeText">Red Coberturada Activa</span>
        </div>
        <h3 id="resultZoneTitle">San Juan de Lurigancho</h3>
        <p class="result-desc" id="resultZoneDesc">Servicio de Fibra Óptica de Alta Velocidad disponible para instalación inmediata.</p>
        
        <div class="result-features">
          <div class="feat">✓ Tecnología 100% Fibra Óptica (FTTH)</div>
          <div class="feat">✓ Instalación en 24 a 48 horas</div>
          <div class="feat">✓ Router Wi-Fi Dual Band homologado</div>
        </div>

        <a href="https://wa.me/51983985748?text=Hola%2C%20consulte%20cobertura%20en%20mi%20zona%20y%20deseo%20contratar%20Fibra%20%C3%93ptica." target="_blank" rel="noopener" class="btn btn-whatsapp-coverage">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Solicitar Instalación en mi Zona</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cobertura-section {
    background-color: var(--color-bg-light);
  }

  .cobertura-box {
    background-color: #FFFFFF;
    border-radius: var(--radius-xl);
    padding: 3.5rem 2.5rem;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    max-width: 900px;
    margin: 0 auto;
  }

  .cobertura-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    margin: 0.75rem 0;
    color: var(--color-dark-heading);
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .search-wrapper {
    max-width: 680px;
    margin: 0 auto 1.5rem;
  }

  .search-form {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .search-form input {
    flex: 1;
    padding: 0.9rem 1.4rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s ease;
  }

  .search-form input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(227, 6, 19, 0.1);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.8rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    border: none;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(227, 6, 19, 0.4);
  }

  .tags-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    justify-content: center;
  }

  .chip {
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-dark);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background-color: #FFF5F5;
  }

  .result-card {
    display: none;
    background-color: #F8FAFC;
    border: 1.5px solid #CBD5E1;
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-align: center;
    margin-top: 2rem;
    animation: fadeIn 0.35s ease;
  }

  .result-card.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #03543F;
    background-color: #DEF7EC;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .dot-green {
    width: 7px;
    height: 7px;
    background-color: #0E9F6E;
    border-radius: 50%;
  }

  .result-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    color: var(--color-dark-heading);
  }

  .result-desc {
    color: var(--color-text-body);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .result-features {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .btn-whatsapp-coverage {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2rem;
    background-color: #25D366;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
  }

  .btn-whatsapp-coverage:hover {
    background-color: #20BA5A;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(37, 211, 102, 0.5);
  }

  @media (max-width: 640px) {
    .search-form {
      flex-direction: column;
    }
    .search-form input {
      border-radius: var(--radius-md);
    }
    .btn-primary {
      width: 100%;
      justify-content: center;
      border-radius: var(--radius-md);
    }
    .cobertura-box {
      padding: 2rem 1.25rem;
    }
  }
</style>

<script>
  const input = document.getElementById('districtInput') as HTMLInputElement | null;
  const btn = document.getElementById('btnCheckCoverage');
  const result = document.getElementById('coverageResult');
  const zoneTitle = document.getElementById('resultZoneTitle');
  const zoneDesc = document.getElementById('resultZoneDesc');

  function checkZone(zoneName: string) {
    const query = zoneName.trim();
    if (!query) return;

    if (zoneTitle) zoneTitle.textContent = `${query} — Cobertura Confirmada`;
    if (zoneDesc) zoneDesc.textContent = `Red de Fibra Óptica FTTH disponible con instalación prioritaria en ${query}.`;
    if (result) result.classList.add('active');
  }

  btn?.addEventListener('click', () => {
    checkZone(input?.value || 'San Juan de Lurigancho');
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      checkZone(input.value || 'San Juan de Lurigancho');
    }
  });

  document.querySelectorAll('.chip').forEach(c => {
    c.addEventListener('click', (e) => {
      const z = (e.currentTarget as HTMLElement).getAttribute('data-zone') || '';
      if (input) input.value = z;
      checkZone(z);
    });
  });
</script>


