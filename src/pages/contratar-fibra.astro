---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contratar Fibra Óptica" description="Solicita tu conexión de alta velocidad por Fibra Óptica." minimalHeader={true}>
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb--1"></div>
      <div class="hero-orb hero-orb--2"></div>
      <div class="hero-grid"></div>
    </div>
    <div class="container hero-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Inicio
        </a>
        <span class="breadcrumb-sep">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </span>
        <span class="breadcrumb-current">Contratar Fibra Óptica</span>
      </nav>
      <div class="hero-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"/></svg>
        100% Fibra Óptica
      </div>
      <h1 class="hero-title">Contratar<br/><span class="hero-title--accent">Fibra Óptica</span></h1>
      <p class="hero-subtitle">Solicita tu conexión de alta velocidad por Fibra Óptica y disfruta de la mejor experiencia de internet.</p>
      <div class="hero-actions">
        <a href="https://wa.me/51983985748" target="_blank" rel="noopener" class="btn-hero">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
          Contratar Ahora
        </a>
        <a href="https://wa.me/51983985748" target="_blank" rel="noopener" class="btn-hero-outline">Contacto por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">600</span>
          <span class="stat-unit">Mbps</span>
          <span class="stat-label">Velocidad Máxima</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">24</span>
          <span class="stat-unit">/7</span>
          <span class="stat-label">Soporte Técnico</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">0</span>
          <span class="stat-unit">S/</span>
          <span class="stat-label">Instalación</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">99</span>
          <span class="stat-unit">%</span>
          <span class="stat-label">Cobertura</span>
        </div>
      </div>
    </div>
  </section>

  <section class="features section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">¿Por qué elegirnos?</span>
        <h2 class="section-title">La mejor fibra óptica<br/><span class="text-accent">para tu hogar</span></h2>
        <p class="section-desc">Ofrecemos conexiones de alta velocidad con la mejor estabilidad y soporte dedicado.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm16,160H112V128h32Zm0-48H112V80h32Z"/></svg>
          </div>
          <h3>Velocidad Garantizada</h3>
          <p>Conexiones simétricas de hasta 600 Mbps. Misma velocidad de subida y bajada para gaming, streaming y trabajo.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176Zm-16-84a12,12,0,1,1,12-12A12,12,0,0,1,128,92Z"/></svg>
          </div>
          <h3>Sin Límite de Datos</h3>
          <p>Navega sin preocupaciones. Todos nuestros planes incluyen consumo ilimitado sin sorpresas en tu factura.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
          </div>
          <h3>Soporte 24/7</h3>
          <p>Nuestro equipo está disponible todos los días para asistirte por teléfono, WhatsApp o en persona.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M240,128a8,8,0,0,1-8,8H216v16a8,8,0,0,1-16,0V136H184a8,8,0,0,1,0-16h16V104a8,8,0,0,1,16,0v16h16A8,8,0,0,1,240,128ZM144,88H112V56a8,8,0,0,0-16,0V88H64a8,8,0,0,0,0,16H96v32a8,8,0,0,0,16,0V104h32a8,8,0,0,0,0-16ZM176,168H80a8,8,0,0,0,0,16h96a8,8,0,0,0,0-16Z"/></svg>
          </div>
          <h3>Instalación Gratis</h3>
          <p>Técnicos certificados instalan tu servicio sin costo adicional. Incluye router WiFi de última generación.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="process section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Proceso Simple</span>
        <h2 class="section-title">Contrata en<br/><span class="text-accent">4 pasos fáciles</span></h2>
      </div>

      <div class="process-grid">
        <div class="process-card">
          <div class="process-number">01</div>
          <h3>Contáctanos</h3>
          <p>Escríbenos por WhatsApp o llámanos para recibir asesoría personalizada.</p>
        </div>
        <div class="process-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </div>
        <div class="process-card">
          <div class="process-number">02</div>
          <h3>Elige tu Plan</h3>
          <p>Selecciona el plan que mejor se adapte a tus necesidades y presupuesto.</p>
        </div>
        <div class="process-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </div>
        <div class="process-card">
          <div class="process-number">03</div>
          <h3>Agenda Instalación</h3>
          <p>Elige la fecha y hora que mejor te convenga para la instalación.</p>
        </div>
        <div class="process-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </div>
        <div class="process-card">
          <div class="process-number">04</div>
          <h3>¡Listo!</h3>
          <p>Disfruta de la mejor conexión a internet en tu hogar o negocio.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-bg">
      <div class="cta-orb cta-orb--1"></div>
      <div class="cta-orb cta-orb--2"></div>
    </div>
    <div class="container cta-container">
      <div class="cta-content">
        <h2>¿Listo para contratar?</h2>
        <p>Contáctanos ahora y comienza a disfrutar de la mejor conexión de fibra óptica.</p>
        <div class="cta-actions">
          <a href="https://wa.me/51983985748" target="_blank" rel="noopener" class="btn-cta">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
            Contratar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* Hero */
  .hero {
    position: relative;
    padding: 8rem 0 5rem;
    background: var(--color-dark);
    overflow: hidden;
    text-align: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .hero-orb--1 {
    width: 500px;
    height: 500px;
    background: var(--color-primary);
    top: -200px;
    right: -100px;
  }

  .hero-orb--2 {
    width: 400px;
    height: 400px;
    background: #B90000;
    bottom: -150px;
    left: -100px;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .breadcrumb a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: #FFFFFF;
  }

  .breadcrumb-sep {
    color: #475569;
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: #FFFFFF;
    font-weight: 600;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(227, 6, 19, 0.15);
    border: 1px solid rgba(227, 6, 19, 0.3);
    color: #FF6B6B;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
  }

  .hero-title--accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #94A3B8;
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-glow);
    transition: all 0.3s ease;
  }

  .btn-hero:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(227, 6, 19, 0.5);
  }

  .btn-hero-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-hero-outline:hover {
    background: rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.3);
  }

  /* Stats */
  .stats {
    padding: 3.5rem 0;
    background: var(--color-bg-white);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-unit {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: var(--color-border);
  }

  /* Features */
  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--color-dark-heading);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .text-accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 2rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all 0.35s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary-border);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--color-primary-light);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .feature-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-dark-heading);
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Process */
  .process {
    background: var(--color-bg-light);
  }

  .process-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .process-card {
    flex: 1;
    min-width: 200px;
    max-width: 240px;
    padding: 2rem 1.5rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: all 0.3s ease;
  }

  .process-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }

  .process-number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .process-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-dark-heading);
    margin-bottom: 0.5rem;
  }

  .process-card p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .process-arrow {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* CTA Section */
  .cta-section {
    position: relative;
    padding: 5rem 0;
    background: var(--color-dark);
    overflow: hidden;
    text-align: center;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cta-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.3;
  }

  .cta-orb--1 {
    width: 400px;
    height: 400px;
    background: var(--color-primary);
    top: -150px;
    left: 20%;
  }

  .cta-orb--2 {
    width: 300px;
    height: 300px;
    background: #B90000;
    bottom: -100px;
    right: 20%;
  }

  .cta-container {
    position: relative;
    z-index: 1;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .cta-content p {
    font-size: 1.1rem;
    color: #94A3B8;
    margin-bottom: 2rem;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2.5rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-glow);
    transition: all 0.3s ease;
  }

  .btn-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(227, 6, 19, 0.5);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr;
    }

    .process-arrow {
      display: none;
    }

    .process-grid {
      gap: 1rem;
    }

    .stats-grid {
      gap: 1.5rem;
    }

    .stat-divider {
      display: none;
    }
  }

  @media (max-width: 576px) {
    .hero {
      padding: 6rem 0 3rem;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
