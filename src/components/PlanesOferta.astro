---
import promocionesData from '../data/promociones.json';
const { modalidades } = promocionesData;
const salesPhone = "51983985748";
---

<section id="planes" class="section-padding planes-section">
  <div class="container">
    <div class="section-header text-center reveal">
      <span class="badge badge-red">{promocionesData.vigencia}</span>
      <h2 class="section-title">Planes y Combos Claro Fibra Óptica</h2>
      <p class="section-description">
        Catálogo técnico y comercial de promociones vigentes. Explora los servicios 1 Play, 2 Play y 3 Play con bonos de velocidad y beneficios exclusivos.
      </p>
    </div>

    <!-- Modalities Showcase Container -->
    <div class="planes-showcase-box reveal reveal-delay-1">
      <div class="planes-header">
        <div class="speed-switcher">
          {modalidades.map((m, idx) => (
            <button
              class={`plan-tab ${idx === 0 ? 'active' : ''}`}
              data-mod-id={m.id}
            >
              {m.tabName}
            </button>
          ))}
        </div>
      </div>

      {modalidades.map((m, mIdx) => (
        <div class={`modality-panel ${mIdx === 0 ? 'active' : ''}`} id={`modality-${m.id}`}>
          <div class="modality-intro text-center">
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
          </div>

          <!-- General Promo Banner for the Modality -->
          <div class="modality-promo-banner">
            <div class="banner-badge-box">
              <span class="banner-pill">OFERTA CAMPAÑA VIGENTE</span>
            </div>
            <h4 class="banner-title">{m.promoGeneralTitle}</h4>
            <p class="banner-text">{m.promoGeneralText}</p>
          </div>

          <!-- Carousel Slider for Cards -->
          <div class="plans-carousel-wrapper">
            <button class="carousel-arrow prev-plan-btn" aria-label="Anterior">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>

            <div class="cards-grid-viewport">
              <div class="cards-grid-track">
                {m.planes.map((p) => {
                  const whatsappMsg = `Hola, deseo consultar disponibilidad sobre el ${p.speed} (${m.tabName}) con ${p.bonoSpeed}.`;
                  const whatsappLink = `https://wa.me/${salesPhone}?text=${encodeURIComponent(whatsappMsg)}`;

                  return (
                    <div class="claro-plan-card">
                      <!-- Top Badge Pill -->
                      <div class="card-top-badge">
                        <span>OFERTA VIGENTE</span>
                      </div>

                      <!-- Category Icon & Header -->
                      <div class="card-modality-header">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                        <span>Fibra Óptica Simétrica</span>
                      </div>

                      <!-- Plan Title -->
                      <h4 class="card-plan-title">
                        {p.speed}
                        <span class="card-tag-badge">{p.tag}</span>
                      </h4>

                      <!-- Spec Items List -->
                      <div class="card-specs-list">
                        <div class="spec-row">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                          <span><strong>Bono:</strong> {p.bonoSpeed}</span>
                        </div>
                        <div class="spec-row">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          <span><strong>Full Claro:</strong> {p.fullClaroSpeed}</span>
                        </div>
                        <div class="spec-row">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
                          <span><strong>Equipos:</strong> {p.equipos}</span>
                        </div>
                        <div class="spec-row">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#E30613" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
                          <span><strong>TV / Contenido:</strong> {p.entretenimiento}</span>
                        </div>
                      </div>

                      <!-- Light Teal/Cyan Highlight Strip -->
                      <div class="card-highlight-strip">
                        <span class="strip-label">BENEFICIO DESTACADO</span>
                        <strong class="strip-value">{p.highlight}</strong>
                      </div>

                      <!-- Card Action Button to WhatsApp -->
                      <div class="card-action-box">
                        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger btn-block">
                          <span>Solicitar por WhatsApp</span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            <button class="carousel-arrow next-plan-btn" aria-label="Siguiente">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>

          <!-- Slide Dots Indicator -->
          <div class="plan-dots-nav"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .planes-section {
    background-color: var(--color-bg-light);
  }

  .section-header {
    max-width: 900px;
    margin: 0 auto 4.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header .badge {
    margin-bottom: 1.5rem;
    padding: 0.55rem 1.5rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: 2.75rem;
    font-weight: 900;
    margin: 0 0 1.25rem 0;
    line-height: 1.2;
    color: var(--color-dark-heading);
  }

  .section-description {
    font-size: 1.15rem;
    color: var(--color-text-body);
    line-height: 1.7;
    max-width: 820px;
    margin: 0 auto;
  }

  .planes-showcase-box {
    background-color: #FAFAFB;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: 4rem 3rem;
    box-shadow: var(--shadow-md);
  }

  .planes-header {
    display: flex;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .speed-switcher {
    display: inline-flex;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.5rem;
    border-radius: var(--radius-full);
    gap: 0.65rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    flex-wrap: wrap;
    justify-content: center;
  }

  .plan-tab {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 0.85rem 2.25rem;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.975rem;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .plan-tab.active {
    background-color: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 4px 16px rgba(227, 6, 19, 0.35);
  }

  .modality-panel {
    display: none;
  }

  .modality-panel.active {
    display: block;
  }

  .modality-intro {
    text-align: center;
    margin-bottom: 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .modality-intro h3 {
    font-size: 2rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
    color: var(--color-dark-heading);
    text-align: center;
    line-height: 1.25;
  }

  .modality-intro p {
    font-size: 1.1rem;
    color: var(--color-text-body);
    margin: 0 auto;
    max-width: 760px;
    text-align: center;
    line-height: 1.7;
  }

  /* General Promo Banner Box */
  .modality-promo-banner {
    background: #FFF5F5;
    border: 1px solid rgba(227, 6, 19, 0.2);
    border-radius: var(--radius-md);
    padding: 2rem 2.5rem;
    text-align: center;
    margin-bottom: 3.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .banner-badge-box {
    margin-bottom: 0.25rem;
  }

  .banner-pill {
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 1.1rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .banner-title {
    font-size: 1.3rem;
    font-weight: 900;
    color: var(--color-primary);
    margin-bottom: 0;
    line-height: 1.35;
  }

  .banner-text {
    font-size: 1.025rem;
    color: var(--color-dark-heading);
    margin: 0 auto;
    max-width: 820px;
    line-height: 1.65;
    font-weight: 600;
  }

  /* Carousel Wrapper */
  .plans-carousel-wrapper {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    position: relative;
  }

  .carousel-arrow {
    background: #FFFFFF;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(227, 6, 19, 0.15);
    z-index: 5;
  }

  .carousel-arrow:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
    transform: scale(1.1);
  }

  .cards-grid-viewport {
    flex: 1;
    overflow: hidden;
    padding: 0.5rem 0.25rem;
  }

  .cards-grid-track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Vertical Card Styling */
  .claro-plan-card {
    flex: 0 0 calc(33.333% - 1rem);
    min-width: 280px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .claro-plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
  }

  .card-top-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #E30613;
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 1rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
    box-shadow: 0 4px 12px rgba(227, 6, 19, 0.35);
    white-space: nowrap;
  }



  .card-modality-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .mini-claro-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .card-plan-title {
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--color-dark-heading);
    text-align: center;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .card-tag-badge {
    background: rgba(227, 6, 19, 0.08);
    color: var(--color-primary);
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .card-specs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .spec-row {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-body);
    line-height: 1.35;
  }

  .spec-row svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Soft Reddish Claro Strip */
  .card-highlight-strip {
    background: rgba(227, 6, 19, 0.05);
    border: 1px solid rgba(227, 6, 19, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    text-align: center;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .strip-label {
    font-size: 0.675rem;
    font-weight: 800;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .strip-value {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-dark-heading);
  }

  .card-action-box {
    margin-top: auto;
  }

  .btn-outline-danger {
    background: #FFFFFF;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    font-weight: 800;
    font-size: 0.875rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: all 0.25s ease;
  }

  .btn-outline-danger:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 6px 18px rgba(227, 6, 19, 0.35);
  }

  .plan-dots-nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .plan-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .plan-dot.active {
    background: var(--color-primary);
    width: 24px;
    border-radius: var(--radius-full);
  }

  @media (max-width: 992px) {
    .claro-plan-card {
      flex: 0 0 calc(50% - 0.75rem);
    }
  }

  @media (max-width: 640px) {
    .claro-plan-card {
      flex: 0 0 100%;
    }
    .planes-showcase-box {
      padding: 2rem 1rem;
    }
    .plan-tab {
      padding: 0.6rem 1.25rem;
      font-size: 0.85rem;
    }
  }
</style>

<script>
  // Tabs for Modalities
  const tabs = document.querySelectorAll('.plan-tab');
  const panels = document.querySelectorAll('.modality-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));

      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');

      const modId = target.getAttribute('data-mod-id');
      const activePanel = document.getElementById(`modality-${modId}`);
      if (activePanel) {
        activePanel.classList.add('active');
        initPanelCarousel(activePanel);
      }
    });
  });

  function initPanelCarousel(panel: HTMLElement) {
    const track = panel.querySelector('.cards-grid-track') as HTMLElement;
    const cards = panel.querySelectorAll('.claro-plan-card');
    const dotsNav = panel.querySelector('.plan-dots-nav');

    if (!track || cards.length === 0) return;

    let currentIndex = 0;
    const itemsPerPage = window.innerWidth > 992 ? 3 : (window.innerWidth > 640 ? 2 : 1);
    const maxIndex = Math.max(0, cards.length - itemsPerPage);

    // Build dots
    if (dotsNav) {
      dotsNav.innerHTML = '';
      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement('button');
        dot.className = `plan-dot ${i === 0 ? 'active' : ''}`;
        dot.setAttribute('aria-label', `Ir a página ${i + 1}`);
        dot.addEventListener('click', () => goToSlide(i));
        dotsNav.appendChild(dot);
      }
    }

    function goToSlide(index: number) {
      if (index < 0) index = maxIndex;
      if (index > maxIndex) index = 0;

      currentIndex = index;

      const cardWidth = (cards[0] as HTMLElement).offsetWidth + 24; // 24px gap
      track.style.transform = `translateX(-${currentIndex * cardWidth}px)`;

      const dots = dotsNav?.querySelectorAll('.plan-dot');
      dots?.forEach((d, idx) => {
        if (idx === currentIndex) d.classList.add('active');
        else d.classList.remove('active');
      });
    }

    const prevBtn = panel.querySelector('.prev-plan-btn');
    const nextBtn = panel.querySelector('.next-plan-btn');

    prevBtn?.replaceWith(prevBtn.cloneNode(true));
    nextBtn?.replaceWith(nextBtn.cloneNode(true));

    const newPrev = panel.querySelector('.prev-plan-btn');
    const newNext = panel.querySelector('.next-plan-btn');

    newPrev?.addEventListener('click', () => goToSlide(currentIndex - 1));
    newNext?.addEventListener('click', () => goToSlide(currentIndex + 1));
  }

  // Initialize active panel on page load
  const initialActive = document.querySelector('.modality-panel.active') as HTMLElement;
  if (initialActive) {
    initPanelCarousel(initialActive);
  }
</script>
