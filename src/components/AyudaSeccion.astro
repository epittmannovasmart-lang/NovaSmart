---
const items = [
  {
    title: "Contratar Fibra Óptica",
    desc: "Solicita tu conexión de alta velocidad desde S/ 79 al mes.",
    image: "/images/equipo/tienda_1.jpg",
    link: "#planes",
    badge: "100% Fibra"
  },
  {
    title: "Atención & Soporte 24/7",
    desc: "Asistencia telefónica y respuesta técnica en sitio.",
    image: "/images/equipo/callcenter_1.jpg",
    link: "#contacto",
    badge: "Respuesta Rápida"
  },
  {
    title: "Visitar Nuestras Tiendas",
    desc: "Encuentra la sede autorizada Claro de Nova Smart más cercana.",
    image: "/images/equipo/tienda_2.jpg",
    link: "#galeria",
    badge: "Sedes Oficiales"
  },
  {
    title: "Trabajar en Nova Smart",
    desc: "Postula a nuestros equipos de campo, ventas y soporte.",
    image: "/images/equipo/promotores_campo_2.jpg",
    link: "#trabajos",
    badge: "Bolsa Activa"
  }
];
---

<section class="section-padding ayuda-section">
  <div class="container">
    <div class="section-header text-center reveal">
      <h2 class="section-title">¿En qué podemos ayudarte?</h2>
      <p class="section-description">
        Selecciona la opción que necesitas para brindarte la mejor atención inmediata.
      </p>
    </div>

    <div class="ayuda-grid reveal reveal-delay-1">
      {items.map((item) => (
        <a href={item.link} class="ayuda-card">
          <div class="card-image-box">
            <img src={item.image} alt={item.title} />
            <div class="card-overlay"></div>
            <span class="card-badge">{item.badge}</span>
          </div>
          <div class="card-info">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <span class="card-arrow">
              <span>Ver más</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ayuda-section {
    background-color: var(--color-bg-light);
    padding: 5rem 0;
  }

  .section-header {
    max-width: 650px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
    color: var(--color-dark-heading);
    letter-spacing: -0.02em;
  }

  .section-description {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .ayuda-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6rem;
  }

  .ayuda-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .ayuda-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.12);
    border-color: rgba(227, 6, 19, 0.35);
  }

  .card-image-box {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .card-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ayuda-card:hover .card-image-box img {
    transform: scale(1.08);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, transparent 40%, rgba(15, 23, 42, 0.65) 100%);
  }

  .card-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(227, 6, 19, 0.35);
    letter-spacing: 0.03em;
  }

  .card-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-info h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-dark-heading);
    margin-bottom: 0.4rem;
  }

  .card-info p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .card-arrow {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    transition: gap 0.2s ease;
  }

  .ayuda-card:hover .card-arrow {
    gap: 0.6rem;
  }

  @media (max-width: 1024px) {
    .ayuda-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .ayuda-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
