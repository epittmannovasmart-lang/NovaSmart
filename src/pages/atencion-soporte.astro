---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Atención & Soporte 24/7" description="Asistencia telefónica y respuesta técnica en sitio las 24 horas del día." minimalHeader={true}>
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb--1"></div>
      <div class="hero-orb hero-orb--2"></div>
      <div class="hero-grid"></div>
    </div>
    <div class="container hero-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Inicio
        </a>
        <span class="breadcrumb-sep">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </span>
        <span class="breadcrumb-current">Atención & Soporte 24/7</span>
      </nav>
      <div class="hero-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
        Respuesta Rápida
      </div>
      <h1 class="hero-title">Atención &<br/><span class="hero-title--accent">Soporte 24/7</span></h1>
      <p class="hero-subtitle">Asistencia telefónica y respuesta técnica en sitio las 24 horas del día, los 7 días de la semana.</p>
      <div class="hero-actions">
        <a href="https://wa.me/51983985748" target="_blank" rel="noopener" class="btn-hero">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.205 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          Contactar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">24</span>
          <span class="stat-unit">hrs</span>
          <span class="stat-label">Disponibilidad</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">5</span>
          <span class="stat-unit">min</span>
          <span class="stat-label">Respuesta WhatsApp</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">48</span>
          <span class="stat-unit">hrs</span>
          <span class="stat-label">Visita Técnica</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">100</span>
          <span class="stat-unit">%</span>
          <span class="stat-label">Resolución</span>
        </div>
      </div>
    </div>
  </section>

  <section class="channels section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Canales de Atención</span>
        <h2 class="section-title">Elige cómo<br/><span class="text-accent">contactarnos</span></h2>
        <p class="section-desc">Múltiples canales para recibir la ayuda que necesitas, cuando la necesitas.</p>
      </div>

      <div class="channels-grid">
        <div class="channel-card">
          <div class="channel-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
          </div>
          <div class="channel-badge">Inmediato</div>
          <h3>WhatsApp 24/7</h3>
          <p>Escríbenos en cualquier momento. Respuesta garantizada en menos de 5 minutos.</p>
          <a href="https://wa.me/51983985748" target="_blank" rel="noopener" class="channel-btn">Enviar Mensaje</a>
        </div>

        <div class="channel-card">
          <div class="channel-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm-16,160H112V128h32Zm0-48H112V80h32Z"/></svg>
          </div>
          <div class="channel-badge">Inmediato</div>
          <h3>Llamada Telefónica</h3>
          <p>Llámanos para recibir asesoría directa con nuestro equipo de soporte especializado.</p>
          <a href="tel:+51983985748" class="channel-btn">Llamar Ahora</a>
        </div>
      </div>
    </div>
  </section>

  <section class="help-section section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">¿Qué podemos resolver?</span>
        <h2 class="section-title">Estamos para<br/><span class="text-accent">ayudarte</span></h2>
      </div>

      <div class="help-grid">
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Corte o intermitencia en el servicio</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Problemas de velocidad lenta</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Configuración de router y equipos</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Consultas de facturación y pagos</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Solicitud de cambio de plan</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Instalación o relocación de servicio</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Reclamos y sugerencias</span>
        </div>
        <div class="help-item">
          <div class="help-check">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <span>Visita técnica a domicilio</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-bg">
      <div class="cta-orb cta-orb--1"></div>
      <div class="cta-orb cta-orb--2"></div>
    </div>
    <div class="container cta-container">
      <div class="cta-content">
        <h2>¿Necesitas ayuda ahora?</h2>
        <p>Llámanos directamente y resolvemos tu problema en el acto.</p>
        <div class="cta-actions">
          <a href="https://wa.me/51983985748" target="_blank" rel="noopener" class="btn-cta">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
            Contacto Directo por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .hero {
    position: relative;
    padding: 8rem 0 5rem;
    background: var(--color-dark);
    overflow: hidden;
    text-align: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .hero-orb--1 {
    width: 500px;
    height: 500px;
    background: var(--color-primary);
    top: -200px;
    right: -100px;
  }

  .hero-orb--2 {
    width: 400px;
    height: 400px;
    background: #B90000;
    bottom: -150px;
    left: -100px;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .breadcrumb a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: #FFFFFF;
  }

  .breadcrumb-sep {
    color: #475569;
    display: flex;
    align-items: center;
  }

  .breadcrumb-current {
    color: #FFFFFF;
    font-weight: 600;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(227, 6, 19, 0.15);
    border: 1px solid rgba(227, 6, 19, 0.3);
    color: #FF6B6B;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .hero-title--accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #94A3B8;
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: var(--gradient-primary);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-glow);
    transition: all 0.3s ease;
  }

  .btn-hero:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(227, 6, 19, 0.5);
  }

  .btn-hero-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-hero-outline:hover {
    background: rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.3);
  }

  .stats {
    padding: 3.5rem 0;
    background: var(--color-bg-white);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat-item { text-align: center; }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-unit {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: var(--color-border);
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .text-accent {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .channel-card {
    position: relative;
    padding: 2.5rem 2rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: all 0.35s ease;
  }

  .channel-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary-border);
  }

  .channel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--color-primary-light);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    margin: 0 auto 1.25rem;
  }

  .channel-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #10B981;
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .channel-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .channel-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .channel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .channel-btn:hover {
    background: var(--gradient-primary);
    color: #FFFFFF;
  }

  .help-section {
    background: var(--color-bg-light);
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .help-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--color-text-body);
    transition: all 0.3s ease;
  }

  .help-item:hover {
    border-color: var(--color-primary-border);
    box-shadow: var(--shadow-sm);
  }

  .help-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: #10B981;
    border-radius: 50%;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .cta-section {
    position: relative;
    padding: 5rem 0;
    background: var(--color-dark);
    overflow: hidden;
    text-align: center;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cta-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.3;
  }

  .cta-orb--1 {
    width: 400px;
    height: 400px;
    background: var(--color-primary);
    top: -150px;
    left: 20%;
  }

  .cta-orb--2 {
    width: 300px;
    height: 300px;
    background: #B90000;
    bottom: -100px;
    right: 20%;
  }

  .cta-container {
    position: relative;
    z-index: 1;
  }

