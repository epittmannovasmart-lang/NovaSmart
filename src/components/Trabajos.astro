<style>
  .trabajos-section {
    background-color: #FFFFFF;
  }

  /* Culture Banner */
  .talento-banner {
    background-color: var(--color-bg-light);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    padding: 3rem;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .banner-text h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.75rem 0 1rem;
  }

  .banner-text p {
    font-size: 1.05rem;
    color: var(--color-text-body);
    line-height: 1.65;
  }

  .banner-image img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .jobs-section-header {
    margin-bottom: 2rem;
  }

  .jobs-section-header h3 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .jobs-section-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .jobs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .job-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
  }

  .job-card:hover {
    border-color: rgba(37, 211, 102, 0.4);
    box-shadow: var(--shadow-md);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .job-type {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .job-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-dark-heading);
    margin-bottom: 0.35rem;
  }

  .job-location {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .job-desc {
    font-size: 0.95rem;
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .job-tags {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    margin-top: auto;
  }

  .j-tag {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .job-apply-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .btn-whatsapp {
    background-color: #25D366;
    color: #FFFFFF;
    border: 1px solid #25D366;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    transition: all 0.25s ease;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
  }

  .btn-whatsapp:hover {
    background-color: #20BA5A;
    border-color: #20BA5A;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.4);
  }

  /* Dual Contact Grid */
  .reclutamiento-directo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .reclutamiento-card {
    background: linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%);
    border: 1px solid #CBD5E1;
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .reclutamiento-card.rec-ventas {
    background: linear-gradient(135deg, #FDF4F4 0%, #FFF5F5 100%);
    border-color: #FECDD3;
  }

  .rec-icon {
    width: 48px;
    height: 48px;
    background-color: rgba(37, 211, 102, 0.15);
    color: #16A34A;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .rec-icon.icon-ventas {
    background-color: rgba(227, 6, 19, 0.12);
    color: #E30613;
  }

  .rec-content h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-dark-heading);
    margin-bottom: 0.25rem;
  }

  .rec-content p {
    font-size: 0.9rem;
    color: var(--color-text-body);
    margin: 0;
    line-height: 1.5;
  }

  .btn-whatsapp-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-dark);
    color: #FFFFFF;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.25s ease;
    align-self: flex-start;
  }

  .btn-whatsapp-secondary:hover {
    background-color: #25D366;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .btn-whatsapp-secondary.btn-ventas-sec {
    background-color: #E30613;
  }

  .btn-whatsapp-secondary.btn-ventas-sec:hover {
    background-color: #B90000;
  }

  @media (max-width: 992px) {
    .talento-banner {
      grid-template-columns: 1fr;
    }
    .jobs-grid {
      grid-template-columns: 1fr;
    }
    .reclutamiento-directo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
