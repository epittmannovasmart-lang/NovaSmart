---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contratar Fibra Óptica" description="Solicita tu conexión de alta velocidad por Fibra Óptica." minimalHeader={true}>
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb--1"></div>
      <div class="hero-orb hero-orb--2"></div>
      <div class="hero-grid"></div>
    </div>
    <div class="container hero-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Inicio
        </a>
        <span class="breadcrumb-sep">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </span>
        <span class="breadcrumb-current">Contratar Fibra Óptica</span>
      </nav>
      <div class="hero-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256"><path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"/></svg>
        100% Fibra Óptica
      </div>
      <h1 class="hero-title">Contratar<br/><span class="hero-title--accent">Fibra Óptica</span></h1>
      <p class="hero-subtitle">Solicita tu conexión de alta velocidad por Fibra Óptica y disfruta de la mejor experiencia de internet.</p>
    </div>
  </section>

  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">600</span>
          <span class="stat-unit">Mbps</span>
          <span class="stat-label">Velocidad Máxima</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">24</span>
          <span class="stat-unit">/7</span>
          <span class="stat-label">Soporte Técnico</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">0</span>
          <span class="stat-unit">S/</span>
          <span class="stat-label">Instalación</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">99</span>
          <span class="stat-unit">%</span>
          <span class="stat-label">Cobertura</span>
        </div>
      </div>
    </div>
  </section>

  <section class="features section-padding">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">¿Por qué elegirnos?</span>
        <h2 class="section-title">La mejor fibra óptica<br/><span class="text-accent">para tu hogar</span></h2>
        <p class="section-desc">Ofrecemos conexiones de alta velocidad con la mejor estabilidad y soporte dedicado.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm16,160H112V128h32Zm0-48H112V80h32Z"/></svg>
          </div>
          <h3>Velocidad Garantizada</h3>
          <p>Conexiones simétricas de hasta 600 Mbps. Misma velocidad de subida y bajada para gaming, streaming y trabajo.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176Zm-16-84a12,12,0,1,1,12-12A12,12,0,0,1,128,92Z"/></svg>
          </div>
          <h3>Sin Límite de Datos</h3>
          <p>Navega sin preocupaciones. Todos nuestros planes incluyen consumo ilimitado sin sorpresas en tu factura.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l0-.12L97.54,33.64a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,79.4,64.6,144,144,144a56.26,56.26,0,0,0,55.88-48.92A16,16,0,0,0,222.37,158.46Z"/></svg>
          </div>
          <h3>Soporte 24/7</h3>
          <p>Nuestro equipo está disponible todos los días para asistirte por teléfono, WhatsApp o en persona.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M240,128a8,8,0,0,1-8,8H216v16a8,8,0,0,1-16,0V136H184a8,8,0,0,1,0-16h16V104a8,8,0,0,1,16,0v16h16A8,8,0,0,1,240,128ZM144,88H112V56a8,8,0,0,0-16,0V88H64a8,8,0,0,0,0,16H96v32a8,8,0,0,0,16,0V104h32a8,8,0,0,0,0-16ZM176,168H80a8,8,0,0,0,0,16h96a8,8,0,0,0,0-16Z"/></svg>
