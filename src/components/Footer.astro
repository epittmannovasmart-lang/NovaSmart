---
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1 -->
      <div class="footer-brand">
        <img src="/logo_oficial.jpeg" alt="Nova Smart - Distribuidor Autorizado Claro" class="footer-logo" />
        <p class="brand-desc">
          Empresa peruana especializada en la instalación, tendido y mantenimiento de redes de fibra óptica y soluciones de telecomunicaciones.
        </p>
      </div>

      <!-- Col 2 -->
      <div class="footer-col">
        <h4>Navegación</h4>
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#nosotros">Quiénes Somos</a></li>
          <li><a href="#planes">Planes Fibra</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#galeria">Nuestro Equipo</a></li>
          <li><a href="#trabajos">Bolsa de Trabajo</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <!-- Col 3 -->
      <div class="footer-col">
        <h4>Líneas de Servicio</h4>
        <ul>
          <li>Instalación FTTH / HFC</li>
          <li>Tendido de Fibra Óptica</li>
          <li>Atención de Emergencias 24/7</li>
          <li>Asesoría Comercial Claro</li>
        </ul>
      </div>

      <!-- Col 4: Atención & Contacto -->
      <div class="footer-col">
        <h4>Central de Atención</h4>
        <p class="contact-note">Atención a clientes residenciales, empresas y postulantes laborales.</p>
        <div class="footer-contact-info">

          <div class="footer-info-line">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+51983985748" style="color: #FFFFFF;">+51 983 985 748</a>
          </div>
          <div class="footer-info-line">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Av. Alfredo Benavides 1180, Miraflores 15074, Lima</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Nova Smart Telecomunicaciones. Todos los derechos reservados.</p>
      <div class="legal-links">
        <a href="#">Políticas de Privacidad</a>
        <span>•</span>
        <a href="#">Términos de Servicio</a>
        <span>•</span>
        <a href="#">Normativa OSIPTEL</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #111827;
    color: #9CA3AF;
    padding: 4.5rem 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .footer-logo {
    height: 68px;
    width: auto;
    object-fit: contain;
    background-color: #FFFFFF;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
    display: block;
  }

  .brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #9CA3AF;
  }

  .footer-col h4 {
    color: #FFFFFF;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col a {
    color: #9CA3AF;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: #FFFFFF;
  }

  .contact-note {
    font-size: 0.85rem;
    margin-bottom: 1rem;
    line-height: 1.5;
    color: #9CA3AF;
  }

  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .footer-info-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid #1F2937;
    font-size: 0.85rem;
  }

  .legal-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .legal-links a {
    color: #9CA3AF;
  }

  .legal-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
