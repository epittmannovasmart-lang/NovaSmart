---
<Layout title="NovaSmart | Fibra, móvil y tecnología" description="Contrata fibra para tu hogar, solicita portabilidad, compra tecnología y encuentra una tienda NovaSmart.">
  <section id="inicio" class="hero hero--brand hero-carousel" aria-roledescription="carrusel" aria-label="Promociones NovaSmart"><div class="hero-carousel__track"><article class="hero-carousel__slide hero-carousel__slide--promo is-active" aria-hidden="false"><img src="/images/promociones/carousel-equipos.png" alt="Smarti presenta celulares y accesorios" /><div class="hero-carousel__shade"></div><div class="hero-carousel__content"><p>Equipos NovaSmart</p><h1>Tu próximo equipo<br />te espera.</h1><span>Celulares y accesorios para conectar con tu ritmo.</span><a class="button button--light" href="#tienda">Ver equipos <b>→</b></a></div></article><article class="hero-carousel__slide hero-carousel__slide--promo" aria-hidden="true"><img src="/images/promociones/carousel-instalacion.png" alt="Instalación de fibra NovaSmart en el hogar" /><div class="hero-carousel__shade"></div><div class="hero-carousel__content"><p>Fibra para tu hogar</p><h2>Internet listo<br />para disfrutar.</h2><span>Coordinamos tu instalación y te acompañamos desde el primer día.</span><a class="button button--light" href="#fibra">Conocer planes <b>→</b></a></div></article><article class="hero-carousel__slide hero-carousel__slide--promo" aria-hidden="true"><img src="/images/promociones/carousel-planes.png" alt="Planes de fibra para el hogar" /><div class="hero-carousel__shade"></div><div class="hero-carousel__content"><p>Planes de fibra</p><h2>Conexión para<br />cada momento.</h2><span>Elige la velocidad que necesita tu hogar.</span><a class="button button--light" href="#fibra">Elegir mi plan <b>→</b></a></div></article><article class="hero-carousel__slide hero-carousel__slide--promo" aria-hidden="true"><img src="/images/promociones/carousel-chips.png" alt="Activación de chip y línea nueva" /><div class="hero-carousel__shade"></div><div class="hero-carousel__content"><p>Líneas nuevas</p><h2>Activa tu chip<br />y sigue conectado.</h2><span>Tenemos una alternativa para tu día a día.</span><a class="button button--light" href="#movil">Solicitar un chip <b>→</b></a></div></article><article class="hero-carousel__slide hero-carousel__slide--promo" aria-hidden="true"><img src="/images/promociones/carousel-tienda.png" alt="Atención NovaSmart en tienda" /><div class="hero-carousel__shade"></div><div class="hero-carousel__content"><p>Tiendas NovaSmart</p><h2>La tecnología<br />más cerca de ti.</h2><span>Visítanos y recibe asesoría para elegir lo que necesitas.</span><a class="button button--light" href="#tiendas">Encuentra tu tienda <b>→</b></a></div></article></div><div class="hero-carousel__controls"><button class="carousel-arrow carousel-arrow--prev" type="button" aria-label="Promoción anterior">←</button><div class="carousel-dots" aria-label="Elegir promoción"><button class="is-active" type="button" aria-label="Ir a la promoción 1"></button><button type="button" aria-label="Ir a la promoción 2"></button><button type="button" aria-label="Ir a la promoción 3"></button><button type="button" aria-label="Ir a la promoción 4"></button><button type="button" aria-label="Ir a la promoción 5"></button></div><button class="carousel-arrow carousel-arrow--next" type="button" aria-label="Siguiente promoción">→</button></div></section>
  <section id="descuentos" class="discounts" aria-labelledby="discounts-title"><div class="container"><h2 id="discounts-title">Descubre los <em>descuentos.</em></h2><div class="discounts__carousel"><button class="discounts__arrow discounts__arrow--prev" type="button" aria-label="Ver descuentos anteriores">←</button><div class="discounts__track">{discounts.map(item=><button class="discounts__item" type="button" aria-label={`Ver descuentos de ${item.label}`}><span class={`discounts__visual discounts__visual--${item.tone}`}><img src={item.image} alt="" loading="lazy" /></span><b>{item.label}</b></button>)}</div><button class="discounts__arrow discounts__arrow--next" type="button" aria-label="Ver más descuentos">→</button></div></div></section>
  <section id="servicios" class="section section--soft"><div class="container"><div class="section-heading section-heading--split"><div><p class="eyebrow eyebrow--dark"><span></span>Elige tu camino</p><h2>¿Qué necesitas<br />hacer hoy?</h2></div></div><div class="service-grid">{services.map(([number,title,text,cta,image],i)=><a class={`service-card service-card--${i+1}`} href={i===0?'#fibra':i===3?'#tienda':'#contacto'}><span class="service-card__number">{number}</span><img class="service-card__image" src={image} alt="" loading="lazy" /><div><h3>{title}</h3><p>{text}</p></div><span class="service-card__cta">{cta} <b>↗</b></span></a>)}</div></div></section>
  <section id="fibra" class="section fibre"><div class="container"><header class="plans-intro"><div><p class="eyebrow eyebrow--dark"><span></span>Internet para tu hogar</p><h2>Elige tu <em>plan.</em></h2></div></header><div class="plans-carousel"><div class="plans-track" aria-label="Ofertas de fibra">{plans.map((plan,index)=><article class:list={['plan-card',{'plan-card--featured':plan.featured}]}><span class="plan-card__flag">Oferta vigente</span><div class="plan-card__visual"><img src={planIllustrations[index]} alt={`Ilustración Smarti para plan de ${plan.speed}`} loading="lazy" /></div><p class="plan-card__kind">⌁ Fibra Óptica Simétrica</p><h3>{plan.speed}</h3><span class="plan-card__tier">{plan.tier}</span><div class="plan-card__price">{plan.price}{plan.promo&&<small>{plan.promo}</small>}{plan.previous&&<del>{plan.previous}</del>}</div><ul><li><b>ϟ Bono:</b> {plan.bonus}</li><li><b>⌁ Equipos:</b> {plan.equipment}</li></ul><div class="plan-card__highlight"><span>Beneficio destacado</span><b>{plan.highlight}</b></div><a href="#contacto">Solicitar <span>→</span></a></article>)}</div><div class="plans-carousel__controls"><button class="plans-arrow plans-arrow--prev" type="button" aria-label="Ver ofertas anteriores">←</button><span>Desliza para ver más ofertas</span><button class="plans-arrow plans-arrow--next" type="button" aria-label="Ver más ofertas">→</button></div></div></div></section>
  <section id="movil" class="section mobile-offer"><div class="container mobile-offer__grid"><div class="mobile-offer__image"><img src="/images/servicios/movil-smart.png" alt="Smarti con chip y teléfono para servicios móviles" /><span>Conserva tu número</span></div><div class="mobile-offer__copy"><p class="eyebrow eyebrow--dark"><span></span>Servicios móviles</p><h2>Tu línea, tu ritmo,<br /><em>tu decisión.</em></h2><p>¿Buscas portarte o activar una línea nueva? Te ayudamos a encontrar la alternativa adecuada y resolver tus dudas de forma simple.</p><div class="button-row"><a class="button button--dark" href="#contacto">Quiero portarme <b>→</b></a><a class="text-link" href="#contacto">Solicitar un chip</a></div></div></div></section>
  <section id="celulares" class="phone-catalog section"><div class="container"><header class="phone-catalog__heading"><h2>Celulares que te <em>recomendamos.</em></h2><div class="phone-catalog__tabs" aria-label="Categorías de productos"><button type="button" class="is-active">Celulares</button><button type="button">Accesorios</button><button type="button">Audio</button></div></header><div class="phone-catalog__grid">{phones.map(phone=><article class={`phone-card phone-card--${phone.className}`}><div class="phone-card__copy"><h3>{phone.name}</h3><p>{phone.plan}</p><span>Precio del equipo</span><strong>{phone.price}</strong></div><img src={phone.image} alt={phone.name} loading="lazy" /><button type="button" aria-label={`Consultar ${phone.name}`}>→</button></article>)}</div><p class="phone-catalog__note">Modelos y precios referenciales.</p></div></section>
  <section id="promociones" class="section promo-section"><div class="container"><div class="section-heading promo-heading promo-heading--single"><div class="promo-heading__title"><p class="eyebrow eyebrow--dark"><span></span>Beneficios NovaSmart</p><h2>Promociones para<br /><em>conectarte más.</em></h2></div></div><div class="promo-grid promo-grid--expanded"><article class="promo-card promo-card--featured"><img src="/images/promociones/promo-equipos-v2.png" alt="Smarti presenta celulares y accesorios NovaSmart" loading="lazy" /><div><span>Equipos seleccionados</span><h3>Renueva tu equipo y aprovecha beneficios especiales.</h3><p>Encuentra un celular que acompañe tu ritmo.</p><button type="button">Ver equipos <b>→</b></button></div></article><article class="promo-card"><img src="/images/promociones/carousel-instalacion.png" alt="Promoción de fibra para el hogar" loading="lazy" /><div><span>Fibra hogar</span><h3>Más velocidad para disfrutar todo en casa.</h3><p>Planes para estudiar, trabajar, jugar y conectar.</p><button type="button">Ver planes <b>→</b></button></div></article><article class="promo-card"><img src="/images/promociones/carousel-chips.png" alt="Promoción de chips y líneas nuevas" loading="lazy" /><div><span>Líneas y chips</span><h3>Activa tu línea y sigue conectado.</h3><p>Elige una alternativa para tu día a día.</p><button type="button">Conocer opciones <b>→</b></button></div></article><article class="promo-card"><img src="/images/promociones/carousel-tienda.png" alt="Promoción de tienda NovaSmart" loading="lazy" /><div><span>Tienda NovaSmart</span><h3>Tecnología cerca de ti.</h3><p>Celulares, accesorios y asesoría en un solo lugar.</p><button type="button">Explorar tienda <b>→</b></button></div></article></div></div></section>
  <section id="entregas" class="delivery-options"><div class="container"><p class="eyebrow eyebrow--dark"><span></span>Compra como prefieras</p><h2>Opciones de <em>entrega.</em></h2><div class="delivery-options__grid"><article><span class="delivery-options__icon">▣</span><div><h3>Retiro en tienda</h3><p>Retira tu pedido en cualquiera de nuestros puntos de atención.</p></div></article><article><span class="delivery-options__icon">▰</span><div><h3>Delivery programado</h3><p>Programa la entrega de tus equipos hasta en 3 días hábiles.</p></div></article><article><span class="delivery-options__icon">ϟ</span><div><h3>Delivery express</h3><p>Recibe tus productos en menos de 24 horas en zonas seleccionadas.</p></div></article></div></div></section>
  <section id="tiendas" class="section locations"><div class="container"><div class="locations__heading"><p class="eyebrow eyebrow--dark"><span></span>NovaSmart cerca de ti</p><h2>Visítanos en <em>nuestras tiendas.</em></h2></div><div class="locations__panel locations__panel--map"><div class="locations__panel-head"><span>10 puntos de atención</span><b>⌖ Lima</b></div><div class="stores-map-layout"><div class="location-list">{stores.map((store,index)=><button class:list={['store-map-link',{'is-active':index===0}]} type="button" data-query={store.query} data-image={store.image} data-name={store.name}><i>{String(index+1).padStart(2,'0')}</i><span>{store.name}</span><b>⌖</b></button>)}</div><div class="stores-photo"><img id="stores-photo" src={stores[0].image} alt={`Tienda NovaSmart ${stores[0].name}`} loading="lazy" /><span class="stores-photo__tag" id="stores-photo-tag">{stores[0].name}</span></div><div class="stores-map"><iframe id="stores-map" title="Mapa de tiendas NovaSmart" src={`https://www.google.com/maps?q=${encodeURIComponent(stores[0].query)}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><span class="stores-map__note">Selecciona una tienda para actualizar el mapa.</span></div></div></div></div></section>
  <section id="contacto" class="contact contact--whatsapp"><div class="container contact-whatsapp"><div class="contact-whatsapp__visual"><img src="/images/smarti-poses/smarti-whatsapp-final.png" alt="Smarti sosteniendo un celular con chat de WhatsApp" loading="lazy" /></div><div class="contact-whatsapp__copy"><p class="eyebrow"><span></span>Asesoría NovaSmart</p><h2>Smarti está listo<br />para <em>ayudarte.</em></h2><button class="button button--light" type="button">Escríbenos por WhatsApp <b>↗</b></button></div></div></section>
  <section id="equipo" class="join-team section" aria-label="Únete al equipo NovaSmart"><div class="container"><div class="join-team__banner"><img src="/images/equipo/unete-al-equipo-novasmart.png" alt="Únete al equipo NovaSmart: personas que hacen posible cada conexión" loading="lazy" /></div></div></section>
  <div class="scroll-progress" aria-hidden="true"></div><button class="novi-help" type="button" aria-label="Hablar con Novi"><img src="/images/novi/smarti-logo-a.png" alt="" /><span>¿Te ayudo?</span></button>
  <section id="preguntas" class="faq-live section"><div class="container"><div class="faq-live__heading"><p class="eyebrow eyebrow--dark"><span></span>Resolvemos tus dudas</p><h2>Conecta sin<br /><em>complicarte.</em></h2></div><div class="faq-live__messages"><article class="message message--one"><b>Cliente</b><p>¿Puedo mantener mi número?</p></article><article class="message message--two"><b>Smarti · NovaSmart</b><p>Sí. Te guiamos con tu portabilidad.</p></article><article class="message message--three"><b>Cliente</b><p>¿Cómo verifico cobertura?</p></article><article class="message message--four"><b>Smarti · NovaSmart</b><p>Déjanos tu distrito y lo revisamos contigo.</p></article><article class="message message--five"><b>Cliente</b><p>¿Cuánto demora la instalación?</p></article><article class="message message--six"><b>Smarti · NovaSmart</b><p>Coordinamos la visita contigo.</p></article><article class="message message--seven"><b>Cliente</b><p>¿Tienen delivery de equipos?</p></article><article class="message message--eight"><b>Smarti · NovaSmart</b><p>Tenemos retiro, programado y express.</p></article></div></div></section>
  <div class="mobile-cta" aria-label="Contacto rápido"><a href="https://wa.me/51983985748?text=Hola%2C%20quiero%20recibir%20asesor%C3%ADa%20de%20NovaSmart" target="_blank" rel="noopener">Hablar por WhatsApp</a></div>
  <style>
    .seo-summary { padding: 76px 0; background: #fff7f4; } .seo-summary .container, .seo-faq .container { max-width: 880px; } .seo-summary h2, .seo-faq h2 { margin: 10px 0 14px; color: #17191d; font: 800 clamp(2rem, 4vw, 3.25rem)/1.05 var(--serif); letter-spacing: -1.4px; } .seo-summary > .container > p:not(.eyebrow) { max-width: 760px; margin: 0 0 22px; color: #555962; line-height: 1.65; } .seo-takeaways { margin-top: 32px; padding: 24px; border-radius: 18px; background: #fff; box-shadow: 0 10px 24px rgba(26,20,20,.07); } .seo-takeaways h3 { margin: 0 0 12px; color: #17191d; font: 800 1.15rem var(--sans); } .seo-takeaways ul { margin: 0; padding-left: 1.25rem; color: #454952; line-height: 1.8; } .seo-faq { padding: 76px 0; background: #fff; } .seo-faq__list { display: grid; gap: 12px; margin-top: 28px; } .seo-faq details { padding: 18px 20px; border: 1px solid #e7e7e9; border-radius: 14px; background: #fff; } .seo-faq summary { cursor: pointer; color: #17191d; font: 800 1rem var(--sans); } .seo-faq details p { margin: 12px 0 0; color: #555962; line-height: 1.6; } .mobile-cta { display: none; } @media (max-width: 700px) { .mobile-cta { position: fixed; z-index: 30; right: 14px; bottom: 14px; left: 14px; display: block; } .mobile-cta a { display: block; padding: 14px 18px; border-radius: 999px; background: #e4231b; color: #fff; text-align: center; font: 800 .9rem var(--sans); box-shadow: 0 10px 24px rgba(171,20,16,.32); } }
  </style>
</Layout>
<script>const progress=document.querySelector('.scroll-progress') as HTMLElement;const sideRail=document.querySelector('.side-rail');const brandHero=document.querySelector('.hero--brand') as HTMLElement;const updateProgress=()=>{const pastCover=scrollY>(brandHero?.offsetHeight||innerHeight)-120;if(progress)progress.style.transform=`scaleX(${scrollY/Math.max(1,document.documentElement.scrollHeight-innerHeight)})`;sideRail?.classList.toggle('is-visible',pastCover)};addEventListener('scroll',updateProgress,{passive:true});addEventListener('resize',updateProgress);updateProgress();const observer=new IntersectionObserver(entries=>entries.forEach(entry=>entry.isIntersecting&&entry.target.classList.add('is-visible')),{threshold:.12});document.querySelectorAll('.section,.contact').forEach(section=>{section.classList.add('reveal-section');observer.observe(section)});const carousel=document.querySelector('.hero-carousel');const slides=Array.from(document.querySelectorAll<HTMLElement>('.hero-carousel__slide'));const dots=Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-dots button'));let currentSlide=0;const showSlide=(index:number)=>{currentSlide=(index+slides.length)%slides.length;slides.forEach((slide,i)=>{const active=i===currentSlide;slide.classList.toggle('is-active',active);slide.setAttribute('aria-hidden',String(!active))});dots.forEach((dot,i)=>dot.classList.toggle('is-active',i===currentSlide))};document.querySelector('.carousel-arrow--prev')?.addEventListener('click',()=>showSlide(currentSlide-1));document.querySelector('.carousel-arrow--next')?.addEventListener('click',()=>showSlide(currentSlide+1));dots.forEach((dot,i)=>dot.addEventListener('click',()=>showSlide(i)));let carouselTimer=window.setInterval(()=>showSlide(currentSlide+1),6500);carousel?.addEventListener('mouseenter',()=>clearInterval(carouselTimer));carousel?.addEventListener('mouseleave',()=>{carouselTimer=window.setInterval(()=>showSlide(currentSlide+1),6500)});document.querySelector<HTMLFormElement>('.service-finder__form')?.addEventListener('submit',event=>{event.preventDefault();const value=(document.querySelector<HTMLInputElement>('#service-query')?.value||'').toLowerCase();const target=/fibra|internet|cobertura/.test(value)?'#fibra':/porta|chip|linea|línea|móvil|movil/.test(value)?'#movil':/celular|equipo|accesorio|tienda/.test(value)?'#tienda':/soporte|instala|manten/.test(value)?'#soporte':'#contacto';document.querySelector(target)?.scrollIntoView({behavior:'smooth'})});const plansTrack=document.querySelector<HTMLElement>('.plans-track');const movePlans=(direction:number)=>plansTrack?.scrollBy({left:direction*(plansTrack.clientWidth/1.2),behavior:'smooth'});document.querySelector('.plans-arrow--prev')?.addEventListener('click',()=>movePlans(-1));document.querySelector('.plans-arrow--next')?.addEventListener('click',()=>movePlans(1));const storesMap=document.querySelector<HTMLIFrameElement>('#stores-map');const storesPhoto=document.querySelector<HTMLImageElement>('#stores-photo');const storesPhotoTag=document.querySelector<HTMLElement>('#stores-photo-tag');document.querySelectorAll<HTMLButtonElement>('.store-map-link').forEach(link=>link.addEventListener('click',()=>{const query=link.dataset.query;const image=link.dataset.image;const name=link.dataset.name;if(storesMap&&query)storesMap.src=`https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;if(storesPhoto&&image){storesPhoto.src=image;storesPhoto.alt=`Tienda NovaSmart ${name||''}`}if(storesPhotoTag&&name)storesPhotoTag.textContent=name;document.querySelectorAll('.store-map-link').forEach(item=>item.classList.toggle('is-active',item===link))}));const discountsTrack=document.querySelector<HTMLElement>('.discounts__track');const moveDiscounts=(direction:number)=>discountsTrack?.scrollBy({left:direction*(discountsTrack.clientWidth*.72),behavior:'smooth'});document.querySelector('.discounts__arrow--prev')?.addEventListener('click',()=>moveDiscounts(-1));document.querySelector('.discounts__arrow--next')?.addEventListener('click',()=>moveDiscounts(1));</script>
